<Window x:Class="DashboardService.Views.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Camera"
        Width="720"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="20"
            Background="{DynamicResource ModalCardBrush}"
            CornerRadius="16"
            Padding="24,20"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Text="Add Camera" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Configure door camera and RFID verification settings"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Camera Name *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NameTextBox" Style="{StaticResource FieldTextBoxStyle}"/>

                        <TextBlock Text="Chamber *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ChamberComboBox"
                                  Height="38"
                                  Margin="0,0,0,14"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="ChamberId"/>

                        <TextBlock Text="Purpose *" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PurposeComboBox"
                                  Height="38"
                                  Margin="0,0,0,14"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="Entry" Tag="ENTRY"/>
                            <ComboBoxItem Content="Exit" Tag="EXIT"/>
                            <ComboBoxItem Content="Door" Tag="DOOR"/>
                            <ComboBoxItem Content="Monitoring" Tag="MONITORING"/>
                        </ComboBox>

                        <TextBlock Text="IP Address" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="IpTextBox" Style="{StaticResource FieldTextBoxStyle}"/>

                        <TextBlock Text="RTSP URL *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="RtspTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Text="rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 Height="56"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Linked RFID Reader" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ReaderComboBox"
                                  Height="38"
                                  Margin="0,0,0,14"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectedValuePath="ReaderId"/>

                        <TextBlock Text="Match Window (seconds) *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="MatchWindowTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Text="10"/>

                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Verification alerts"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,10"/>
                                <CheckBox x:Name="PersonDetectionCheckBox"
                                          Content="Enable person detection"
                                          IsChecked="True"
                                          Margin="0,0,0,10"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <CheckBox x:Name="AlertNoRfidCheckBox"
                                          Content="Alert when camera sees people but RFID has none / no scan"
                                          IsChecked="True"
                                          Margin="0,0,0,10"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <CheckBox x:Name="AlertTailgateCheckBox"
                                          Content="Alert when camera count is higher than RFID (mismatch / tailgate)"
                                          IsChecked="True"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Door/Entry: match IN events with RFID scans. Monitoring: match people visible in chamber with RFID open entries."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton"
                        Content="Save"
                        Width="110"
                        Height="40"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
