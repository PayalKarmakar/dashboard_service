<Window x:Class="DashboardService.Views.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Camera"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="24"
            Background="{DynamicResource ModalCardBrush}"
            CornerRadius="16"
            Padding="28,24"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Add Camera" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Configure door camera and RFID verification settings"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,18"/>

            <TextBlock Text="Camera Name *" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="NameTextBox" Style="{StaticResource FieldTextBoxStyle}"/>

            <TextBlock Text="Chamber *" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ChamberComboBox"
                      Height="40"
                      Margin="0,6,0,14"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="ChamberId"/>

            <TextBlock Text="Purpose *" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="PurposeComboBox"
                      Height="40"
                      Margin="0,6,0,14"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      SelectedIndex="2">
                <ComboBoxItem Content="Entry" Tag="ENTRY"/>
                <ComboBoxItem Content="Exit" Tag="EXIT"/>
                <ComboBoxItem Content="Door" Tag="DOOR"/>
                <ComboBoxItem Content="Monitoring" Tag="MONITORING"/>
            </ComboBox>

            <TextBlock Text="IP Address" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="IpTextBox" Style="{StaticResource FieldTextBoxStyle}"/>

            <TextBlock Text="RTSP URL *" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="RtspTextBox"
                     Style="{StaticResource FieldTextBoxStyle}"
                     Text="rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101"/>

            <TextBlock Text="Linked RFID Reader" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ReaderComboBox"
                      Height="40"
                      Margin="0,6,0,14"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      DisplayMemberPath="DisplayLabel"
                      SelectedValuePath="ReaderId"/>

            <TextBlock Text="Match Window (seconds) *" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="MatchWindowTextBox"
                     Style="{StaticResource FieldTextBoxStyle}"
                     Text="10"/>

            <CheckBox x:Name="PersonDetectionCheckBox"
                      Content="Enable person detection"
                      IsChecked="True"
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
            <CheckBox x:Name="AlertNoRfidCheckBox"
                      Content="Alert when person enters without RFID scan"
                      IsChecked="True"
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
            <CheckBox x:Name="AlertTailgateCheckBox"
                      Content="Alert on tailgating (more persons than RFID scans)"
                      IsChecked="True"
                      Margin="0,0,0,18"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton"
                        Content="Save"
                        Width="110"
                        Height="40"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
