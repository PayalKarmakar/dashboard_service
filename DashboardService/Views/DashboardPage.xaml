<Page x:Class="DashboardService.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Bahnschrift, Segoe UI"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ================================ -->
        <!-- COLORS / STYLES -->
        <!-- ================================ -->

        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="0">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="16,0"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBgBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarTextActiveBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ================================ -->
        <!-- DATAGRID STYLE -->
        <!-- ================================ -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F8FAFC"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E9EEF5"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeight"
                    Value="58"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="False"/>

            <Setter Property="FontSize"
                    Value="14"/>

        </Style>


        <!-- DATAGRID HEADER -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F7F9FC"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="BorderBrush"
                    Value="#E7EDF4"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- DATAGRID CELL -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

        </Style>


        <!-- DATAGRID ROW -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E9EEF5"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="DataGridRow">

                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <SelectiveScrollingGrid>

                                <SelectiveScrollingGrid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </SelectiveScrollingGrid.ColumnDefinitions>

                                <DataGridCellsPresenter
                                    Grid.Column="1"/>

                            </SelectiveScrollingGrid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#F5F9FF"/>

                            </Trigger>

                            <Trigger Property="AlternationIndex"
                                     Value="1">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#FAFBFD"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================ -->
        <!-- PROGRESS BAR -->
        <!-- ================================ -->

        <Style TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="8"/>

            <Setter Property="Background"
                    Value="#E7EDF4"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">

                            <Grid ClipToBounds="True">

                                <Border x:Name="PART_Track"
                                        CornerRadius="4"/>

                                <Border x:Name="PART_Indicator"
                                        Background="#0A3776"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>


    <!-- ===================================== -->
    <!-- MAIN LAYOUT -->
    <!-- ===================================== -->

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="230"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================== -->

        <Border Grid.Column="0" ClipToBounds="True"
                Background="{DynamicResource SidebarBgBrush}">

            <Grid>

                <Ellipse Width="220" Height="220"
                         Fill="#14FFFFFF"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-90,-80,0,0"
                         IsHitTestVisible="False"/>

                <Ellipse Width="160" Height="160"
                         Fill="#10FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-50,-40"
                         IsHitTestVisible="False"/>

                <!-- Sci-fi grid lines (visible in dark mode via overlay opacity) -->
                <Border x:Name="SidebarSciFiOverlay"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#3322D3EE" Thickness="0.6"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="28,0"/>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,28"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                </Border>

                <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="160"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="95"/>

                </Grid.RowDefinitions>


                <!-- BRAND -->

                <StackPanel Grid.Row="0"
                            Margin="24,32,20,0">

                    <Border Width="48" Height="48"
                            CornerRadius="14"
                            Background="#22FFFFFF"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"
                            Padding="6">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock Text="SRP INNOVATIONS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#9FC8F5"/>

                    <TextBlock Text="Smart Chamber"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Monitoring"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,-2,0,0"/>

                    <Border Height="1"
                            Background="#33FFFFFF"
                            Margin="0,18,20,0"/>

                </StackPanel>


                <!-- MENU -->

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel Margin="14,10,14,0">


                    <!-- DASHBOARD -->

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="{DynamicResource SidebarActiveBgBrush}"
                            Foreground="{DynamicResource SidebarTextActiveBrush}"
                            Click="DashboardMenu_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#x25A6;"
                                       FontSize="19"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Dashboard"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- CHAMBERS -->

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="ChambersMenu_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#x25C8;"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Chambers"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- EMPLOYEES -->

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="EmployeesMenu_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#x2659;"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Employees"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="ReadersMenu_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="&#x229B;"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="RFID Readers"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="LiveCameraMenu_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◎"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Live Camera"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="ReportsToggle_Click">

                        <Grid>
                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25A4;"
                                           FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                                <TextBlock Text="Reports"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock x:Name="ReportsArrowText"
                                       Text="&#x25BC;"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                        </Grid>

                    </Button>

                    <StackPanel x:Name="ReportsSubMenuPanel"
                                Margin="18,0,0,4"
                                Visibility="Collapsed">

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="EntryExitReportMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Entry / Exit"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="ChamberEmployeesReportMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Chamber Employees"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="ChamberCriticalReportMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Chamber Critical"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="ProductionLossReportMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Production Loss"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Height="40"
                                    Click="SensorReadingsReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensor Readings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                    </StackPanel>

                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Click="ConfigurationToggle_Click">

                        <Grid>
                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x2699;"
                                           FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                                <TextBlock Text="Configuration"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock x:Name="ConfigurationArrowText"
                                       Text="&#x25BC;"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                        </Grid>

                    </Button>

                    <StackPanel x:Name="ConfigurationSubMenuPanel"
                                Margin="18,0,0,4"
                                Visibility="Collapsed">

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="SensorConfigurationMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Sensor"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Height="40"
                                Click="CameraConfigurationMenu_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x25B8;"
                                           FontSize="14"
                                           Width="24"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Camera"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </StackPanel>
                </ScrollViewer>


                <!-- FOOTER -->

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12,0,12,10">

                    <TextBlock Text="&#x00A9; 2026 SRP Innovations"
                               Foreground="#9FC8F5"
                               FontSize="10"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="10"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#A8C8EC">
                        <Run Text="Designed &amp; Developed by "/>
                        <Hyperlink NavigateUri="https://codeinq.com/"
                                   RequestNavigate="CodeInqLink_RequestNavigate"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   TextDecorations="Underline"
                                   Cursor="Hand">
                            <Run Text="CodeInQ"/>
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>

            </Grid>

            </Grid>

        </Border>


        <!-- ===================================== -->
        <!-- CONTENT -->
        <!-- ===================================== -->

        <Grid Grid.Column="1"
              Margin="28,22,28,22"
              Background="{DynamicResource ContentAreaBgBrush}">

            <!-- Sci-fi atmosphere overlay -->
            <Border x:Name="ContentSciFiOverlay"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#1422D3EE" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <ScrollViewer Panel.ZIndex="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

            <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ===================================== -->
            <!-- HEADER -->
            <!-- ===================================== -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,14"
                  Panel.ZIndex="1000">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,320,0">
                    <TextBlock Text="OPERATIONS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DashboardTitleText"
                               Text="Live Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="Chamber occupancy, alerts and member timers"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                    <!-- DARK MODE TOGGLE -->
                    <Border x:Name="ThemeToggleButton"
                            Background="{DynamicResource ProfileBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            MouseLeftButtonUp="ThemeToggle_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ThemeToggleTrack"
                                    Width="42"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource ThemeToggleTrackBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <Border x:Name="ThemeToggleKnob"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        Background="{DynamicResource ThemeToggleKnobBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeToggleLabel"
                                           Text="DARK MODE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="ThemeToggleStateText"
                                           Text="OFF"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

            <!-- Profile container: relative positioning equivalent (Grid + Popup overlay) -->
            <Grid HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Panel.ZIndex="1000">

                <!-- ADMINISTRATOR BUTTON -->

                <Border x:Name="AdminMenuButton"
                        Background="{DynamicResource ProfileBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MouseLeftButtonUp="AdminMenuButton_MouseLeftButtonUp">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="2"
                                          Opacity="0.06"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal">

                        <Border Width="38"
                                Height="38"
                                Background="#0A3776"
                                CornerRadius="19">

                            <TextBlock x:Name="AdminInitialText"
                                       Text="A"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,8,0"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="AdminNameText"
                                       Text="Administrator"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock x:Name="AdminRoleText"
                                       Text="ADMIN"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                        <TextBlock x:Name="AdminMenuArrow"
                                   Text="&#x25BC;"
                                   FontSize="9"
                                   Foreground="#8793A3"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                    </StackPanel>

                </Border>


                <!-- OVERLAY MENU: floats above dashboard, does not affect layout flow -->

                <Popup x:Name="AdminMenuPopup"
                       PlacementTarget="{Binding ElementName=AdminMenuButton}"
                       Placement="Bottom"
                       VerticalOffset="8"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       PopupAnimation="Fade"
                       Closed="AdminMenuPopup_Closed">

                    <Border x:Name="AdminMenuPanel"
                            Width="230"
                            Background="{DynamicResource ModalCardBrush}"
                            CornerRadius="14"
                            Padding="8"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="3"
                                              Opacity="0.14"/>
                        </Border.Effect>

                        <StackPanel>

                            <Button Click="Logout_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,10"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder"
                                                        Property="Background"
                                                        Value="#FEF2F2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32"
                                            Height="32"
                                            Background="#FEF2F2"
                                            CornerRadius="8"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="OUT"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#DC2626"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Logout"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DC2626"/>
                                        <TextBlock Text="Sign out from dashboard"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                    </Border>

                </Popup>

            </Grid>

                </StackPanel>

            </Grid>

            <!-- ===================================== -->
            <!-- SUMMARY CARDS -->
            <!-- ===================================== -->

            <Grid Grid.Row="1"
                  Margin="0,4,0,8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="14"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="14"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="14"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- MEMBERS -->

                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="#0A3776" CornerRadius="4,0,0,4" Margin="-20,-18,0,-18"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="MEMBERS INSIDE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="MembersInsideText"
                                       Text="0"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       FontFamily="Bahnschrift"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Currently in chambers"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- CHAMBERS -->

                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="#1D6FB8" CornerRadius="4,0,0,4" Margin="-20,-18,0,-18"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="ACTIVE CHAMBERS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ActiveChambersText"
                                       Text="0"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       FontFamily="Bahnschrift"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Monitored zones"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- ALERTS -->

                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="#D97706" CornerRadius="4,0,0,4" Margin="-20,-18,0,-18"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="ACTIVE ALERTS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="AlertsText"
                                       Text="0"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       FontFamily="Bahnschrift"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Attention / Warning"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- VIOLATIONS -->

                <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left" Background="#DC2626" CornerRadius="4,0,0,4" Margin="-20,-18,0,-18"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="TIME VIOLATIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ViolationsText"
                                       Text="0"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       FontFamily="Bahnschrift"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Exceeded duration"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <!-- ============================================ -->
            <!-- RFID READER STATUS -->
            <!-- ============================================ -->

            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="14,12"
                    Style="{StaticResource KpiCardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RFID Readers"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border Background="#ECFDF5"
                                    CornerRadius="10"
                                    Padding="9,4"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="#22A06B"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#15803D"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="RfidServiceStatusText"
                                   Grid.Column="1"
                                   Text="Checking RFID service..."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RFID CONNECTED -->
                        <Border Grid.Column="0"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#22C55E"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="CONNECTED"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#166534"
                                               Margin="8,0,0,0"/>
                                    <TextBlock x:Name="ConnectedReadersCountText"
                                               Text="(0)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#15803D"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <ItemsControl x:Name="ConnectedReadersItemsControl"
                                              Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#DCFCE7"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReaderName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#14532D"/>
                                                    <TextBlock Text="{Binding LocationDisplay}"
                                                               FontSize="11"
                                                               Foreground="#166534"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding PurposeDisplay}"
                                                               FontSize="10"
                                                               Foreground="#15803D"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoConnectedReadersText"
                                           Grid.Row="1"
                                           Text="No readers connected."
                                           FontSize="12"
                                           Foreground="#166534"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- RFID DISCONNECTED -->
                        <Border Grid.Column="2"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#EF4444"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="DISCONNECTED"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#991B1B"
                                               Margin="8,0,0,0"/>
                                    <TextBlock x:Name="DisconnectedReadersCountText"
                                               Text="(0)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#B91C1C"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <ItemsControl x:Name="DisconnectedReadersItemsControl"
                                              Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#FEE2E2"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReaderName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#7F1D1D"/>
                                                    <TextBlock Text="{Binding LocationDisplay}"
                                                               FontSize="11"
                                                               Foreground="#991B1B"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding PurposeDisplay}"
                                                               FontSize="10"
                                                               Foreground="#B91C1C"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoDisconnectedReadersText"
                                           Grid.Row="1"
                                           Text="All readers are connected."
                                           FontSize="12"
                                           Foreground="#991B1B"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SENSORS (same Connected / Disconnected layout) -->
                    <Grid Grid.Row="2" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sensors"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border Background="#ECFDF5"
                                    CornerRadius="10"
                                    Padding="9,4"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="#22A06B"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="LIVE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#15803D"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="SensorServiceStatusText"
                                   Grid.Column="1"
                                   Text="Checking sensors..."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SENSOR CONNECTED -->
                        <Border Grid.Column="0"
                                Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#22C55E"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="CONNECTED"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#166534"
                                               Margin="8,0,0,0"/>
                                    <TextBlock x:Name="ConnectedSensorsCountText"
                                               Text="(0)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#15803D"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <ItemsControl x:Name="ConnectedSensorsItemsControl"
                                              Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#DCFCE7"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#14532D"/>
                                                    <TextBlock Text="{Binding LocationDisplay}"
                                                               FontSize="11"
                                                               Foreground="#166534"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding DetailDisplay}"
                                                               FontSize="10"
                                                               Foreground="#15803D"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoConnectedSensorsText"
                                           Grid.Row="1"
                                           Text="No sensors connected."
                                           FontSize="12"
                                           Foreground="#166534"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- SENSOR DISCONNECTED -->
                        <Border Grid.Column="2"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#EF4444"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="DISCONNECTED"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#991B1B"
                                               Margin="8,0,0,0"/>
                                    <TextBlock x:Name="DisconnectedSensorsCountText"
                                               Text="(0)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#B91C1C"
                                               Margin="6,0,0,0"/>
                                </StackPanel>

                                <ItemsControl x:Name="DisconnectedSensorsItemsControl"
                                              Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#FEE2E2"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#7F1D1D"/>
                                                    <TextBlock Text="{Binding LocationDisplay}"
                                                               FontSize="11"
                                                               Foreground="#991B1B"
                                                               Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding DetailDisplay}"
                                                               FontSize="10"
                                                               Foreground="#B91C1C"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoDisconnectedSensorsText"
                                           Grid.Row="1"
                                           Text="All sensors are connected."
                                           FontSize="12"
                                           Foreground="#991B1B"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- CHAMBER STATUS + SENSOR MONITORING -->
            <!-- ============================================ -->

            <Grid Grid.Row="3"
      Margin="0,12,0,0">

                <Grid.ColumnDefinitions>

                    <!-- Chamber Status -->
                    <ColumnDefinition Width="320"/>

                    <!-- Space -->
                    <ColumnDefinition Width="18"/>

                    <!-- Sensor Monitoring -->
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ============================================ -->
                <!-- LEFT : CHAMBER STATUS -->
                <!-- ============================================ -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- HEADING -->

                    <Grid Grid.Row="0">

                        <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                            <TextBlock Text="Chamber Status"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border Background="#ECFDF5"
                        CornerRadius="10"
                        Padding="9,4"
                        Margin="12,0,0,0">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="6"
                                 Height="6"
                                 Fill="#22A06B"
                                 VerticalAlignment="Center"/>

                                    <TextBlock Text="LIVE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#15803D"
                                   Margin="5,0,0,0"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>


                    <!-- CHAMBER CARD -->

                    <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">

                        <!-- IMPORTANT:
                 Keep only this one ChambersItemsControl
                 Do not create another one elsewhere -->

                        <ItemsControl x:Name="ChambersItemsControl">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>


                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Width="300"
                                Height="155"
                                Background="White"
                                CornerRadius="16"
                                Padding="18"
                                BorderBrush="#D8E3F0"
                                BorderThickness="1"
                                Margin="0,0,12,0">

                                        <Border.Effect>

                                            <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Opacity="0.08"
                                                  Color="#0A3776"/>

                                        </Border.Effect>


                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="*"/>

                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>


                                            <!-- TOP -->

                                            <Grid Grid.Row="0">

                                                <StackPanel>

                                                    <TextBlock Text="{Binding ChamberName}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                    <TextBlock Text="{Binding ChamberCode}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,4,0,0"/>

                                                </StackPanel>


                                                <!-- OCCUPANCY -->

                                                <Border Background="{DynamicResource AvatarBgBrush}"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">

                                                    <TextBlock FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}">

                                            <Run Text="{Binding MemberCount}"/>

                                            <Run Text=" / "/>

                                            <Run Text="{Binding MemberThreshold}"/>

                                                    </TextBlock>

                                                </Border>

                                            </Grid>


                                            <!-- CURRENT OCCUPANCY -->

                                            <StackPanel Grid.Row="1"
                                            VerticalAlignment="Center">

                                                <TextBlock Text="CURRENT OCCUPANCY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>

                                                <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,6,0,0">

                                        <Run Text="{Binding MemberCount}"/>

                                        <Run Text=" Members Inside"/>

                                                </TextBlock>

                                            </StackPanel>


                                            <!-- PROGRESS -->

                                            <ProgressBar Grid.Row="2"
                                             Height="7"
                                             Value="{Binding OccupancyPercentage, Mode=OneWay}"
                                             Maximum="100"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>


                <!-- ============================================ -->
                <!-- RIGHT : SENSOR MONITORING -->
                <!-- ============================================ -->

                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- SENSOR MONITORING HEADING -->

                    <Grid Grid.Row="0" Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- TITLE -->

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Sensor Monitoring"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                        </StackPanel>


                        <!-- VOICE LANG + SENSOR VOICE + LIVE -->

                        <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                            <!-- Voice language -->
                            <Border Background="#F1F5F9"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Voice"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <RadioButton x:Name="VoiceLangEnglishRadio"
                                                 Content="English"
                                                 GroupName="DashboardVoiceLang"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Foreground="#0A3776"
                                                 IsChecked="True"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Checked="VoiceLanguageRadio_Checked"/>
                                    <RadioButton x:Name="VoiceLangBengaliRadio"
                                                 Content="বাংলা"
                                                 GroupName="DashboardVoiceLang"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 Foreground="#0A3776"
                                                 VerticalAlignment="Center"
                                                 Checked="VoiceLanguageRadio_Checked"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="StopSensorVoiceButton"
                                    Content="Stop Voice"
                                    Height="28"
                                    Padding="12,0"
                                    Margin="0,0,6,0"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="StopSensorVoice_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="StartSensorVoiceButton"
                                    Content="Start Voice"
                                    Height="28"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Background="#16A34A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Click="StartSensorVoice_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}"
                                                Opacity="{TemplateBinding Opacity}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- CHAMBER -->

                            <Border Background="#EAF2FC"
                        CornerRadius="10"
                        Padding="10,5"
                        Margin="0,0,8,0">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="6"
                                 Height="6"
                                 Fill="#0A3776"
                                 VerticalAlignment="Center"/>

                                    <TextBlock Text="Chamber 01"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#0A3776"
                                   Margin="6,0,0,0"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>


                    <!-- SENSOR CARD CONTAINER -->
                        <Border Grid.Row="1"
        Background="White"
        CornerRadius="16"
        Padding="12"
        BorderBrush="#E2E8F0"
        BorderThickness="1">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                           ShadowDepth="3"
                           Opacity="0.06"/>
                            </Border.Effect>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- ================================= -->
                                <!-- TEMPERATURE -->
                                <!-- ================================= -->

                                <Border x:Name="TemperatureCardBorder"
                                    Grid.Column="0"
                                    CornerRadius="14"
                                    Padding="14"
                                    BorderBrush="#FED7AA"
                                    BorderThickness="1">

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFF7ED" Offset="0"/>
                                            <GradientStop Color="#FFEDD5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="TEMPERATURE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#C2410C"/>

                                        <TextBlock x:Name="TemperatureValueText"
                           Grid.Row="1"
                           Text="--"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Bahnschrift"
                           Foreground="#EA580C"
                           VerticalAlignment="Center"
                           Margin="0,4"/>

                                        <Border x:Name="TemperatureStatusBorder" 
                                            Grid.Row="2"                           
                           Background="#DCFCE7"
        BorderBrush="#4ADE80"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10,5"
        HorizontalAlignment="Left">

                                            <TextBlock x:Name="TemperatureStatusText"
                                               Text="NORMAL"
                                               FontSize="12"
                                               FontWeight="Bold"
                                                        Foreground="#166534"
                                              />    

                                        </Border>

                                    </Grid>

                                </Border>


                                <!-- ================================= -->
                                <!-- HUMIDITY -->
                                <!-- ================================= -->

                                <Border x:Name="HumidityCardBorder"
                                    Grid.Column="2"
                CornerRadius="14"
                Padding="14"
                BorderBrush="#BAE6FD"
                BorderThickness="1">

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0F9FF" Offset="0"/>
                                            <GradientStop Color="#E0F2FE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="HUMIDITY"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#0369A1"/>

                                        <TextBlock x:Name="HumidityValueText"
                           Grid.Row="1"
                           Text="--"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Bahnschrift"
                           Foreground="#0284C7"
                           VerticalAlignment="Center"
                           Margin="0,4"/>

                                        <Border x:Name="HumidityStatusBorder"  
                                            Grid.Row="2"
                       Background="#DCFCE7"
        BorderBrush="#4ADE80"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10,5"
        HorizontalAlignment="Left">

                                            <TextBlock x:Name="HumidityStatusText"
           Text="NORMAL"
           FontSize="12"
           FontWeight="Bold"
                                                        Foreground="#166534"/>

                                        </Border>

                                    </Grid>

                                </Border>


                                <!-- ================================= -->
                                <!-- CO -->
                                <!-- ================================= -->

                                <Border x:Name="CoCardBorder"
                                    Grid.Column="4"
                                    CornerRadius="14"
                                    Padding="14"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1">    

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FEF2F2" Offset="0"/>
                                            <GradientStop Color="#FEE2E2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="CO"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#B91C1C"/>

                                        <TextBlock x:Name="CoValueText"
                                           Grid.Row="1"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           FontFamily="Bahnschrift"
                                           Foreground="#DC2626"
                                           VerticalAlignment="Center"
                                           Margin="0,4"/>

                                        <Border x:Name="CoStatusBorder" 
                                            Grid.Row="2"
        Background="#DCFCE7"
        BorderBrush="#4ADE80"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10,5"
        HorizontalAlignment="Left">

                                            <TextBlock x:Name="CoStatusText"
                   Text="NORMAL"
                   FontSize="12"
                   FontWeight="Bold"
                                                        Foreground="#166534"/>      

                                        </Border>

                                    </Grid>

                                </Border>


                                <!-- ================================= -->
                                <!-- CO2 -->
                                <!-- ================================= -->

                                <Border x:Name="Co2CardBorder"
                                    Grid.Column="6"
                                    CornerRadius="14"
                                    Padding="14"
                                    BorderBrush="#DDD6FE"
                                    BorderThickness="1">    

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FAF5FF" Offset="0"/>
                                            <GradientStop Color="#F3E8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="CO2"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#6D28D9"/>

                                        <TextBlock x:Name="Co2ValueText"
                                           Grid.Row="1"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           FontFamily="Bahnschrift"
                                           Foreground="#7C3AED"
                                           VerticalAlignment="Center"
                                           Margin="0,4"/>

                                        <Border x:Name="Co2StatusBorder"  
                                            Grid.Row="2"
                                            Background="#DCFCE7"
                                            BorderBrush="#4ADE80"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            HorizontalAlignment="Left">     

                                            <TextBlock x:Name="Co2StatusText"
                                           Text="NORMAL"
                                           FontSize="12"
                                           FontWeight="Bold"
                                                   Foreground="#166534"/>  

                                        </Border>

                                    </Grid>

                                </Border>


                                <!-- ================================= -->
                                <!-- OXYGEN -->
                                <!-- ================================= -->

                                <Border x:Name="OxygenCardBorder"
                                    Grid.Column="8"
                                    CornerRadius="14"
                                    Padding="14"
                                    BorderBrush="#BBF7D0"
                                    BorderThickness="1">            

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0FDF4" Offset="0"/>
                                            <GradientStop Color="#DCFCE7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="OXYGEN"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#166534"/>

                                        <TextBlock x:Name="OxygenValueText"
                           Grid.Row="1"
                           Text="--"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Bahnschrift"
                           Foreground="#15803D"
                           VerticalAlignment="Center"
                           Margin="0,4"/>

                                        <Border x:Name="OxygenStatusBorder" 
                                            Grid.Row="2"
                                            Background="#DCFCE7"
                                            BorderBrush="#4ADE80"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            HorizontalAlignment="Left">     

                                            <TextBlock x:Name="OxygenStatusText"
                                           Text="NORMAL"
                                           FontSize="12"
                                           FontWeight="Bold"
                                                        Foreground="#166534"/>  

                                        </Border>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>

            </Grid>



            <!-- ===================================== -->
            <!-- CURRENT MEMBERS -->
            <!-- ===================================== -->

            <Border Grid.Row="4"
				Margin="0,18,0,24"
				MinHeight="360"
				Background="{DynamicResource CardBgBrush}"
				CornerRadius="18"
				BorderBrush="{DynamicResource CardBorderBrush}"
				BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="2"
                          Opacity="0.09"
                          Color="#0A3776"/>
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- HEADER -->

                    <Grid Grid.Row="0"
              Margin="24,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Current Members"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="Employees currently inside monitored chambers"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,5,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="StopAllVoiceButton"
                                    Content="Stop All Voice"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="StopAllVoice_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ViewMoreMembersButton"
                                    Content="View More"
                                    Height="32"
                                    Padding="12,0"
                                    Background="#0A3776"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="ViewMoreMembers_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>

                    </Grid>


                    <!-- DATA GRID -->

                    <DataGrid Grid.Row="1"
                  x:Name="MembersDataGrid"
                  Margin="12,0,12,12"
                  MinHeight="280"
                  MaxHeight="440"
                  ItemsSource="{Binding CurrentMembers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  VerticalGridLinesBrush="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  Background="{DynamicResource CardBgBrush}"
                  RowHeight="68"
                  FontSize="13"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FocusVisualStyle="{x:Null}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  HorizontalGridLinesBrush="Transparent">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF2FC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B2248"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF2FC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B2248"/>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="RowChrome"
                                                    Margin="0,0,0,1"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#EEF2F7"
                                                    BorderThickness="0,0,0,1"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Border x:Name="StatusAccent"
                                                            Width="4"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            CornerRadius="2,0,0,2"/>
                                                    <SelectiveScrollingGrid Margin="4,0,0,0">
                                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </SelectiveScrollingGrid.ColumnDefinitions>
                                                        <DataGridCellsPresenter Grid.Column="1"
                                                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    </SelectiveScrollingGrid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="#F8FBFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="#EAF2FC"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                    <Setter TargetName="StatusAccent" Property="Background" Value="#3B82F6"/>
                                                    <Setter TargetName="RowChrome" Property="Background" Value="#F8FBFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter TargetName="StatusAccent" Property="Background" Value="#F59E0B"/>
                                                    <Setter TargetName="RowChrome" Property="Background" Value="#FFFCF5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                    <Setter TargetName="StatusAccent" Property="Background" Value="#EF4444"/>
                                                    <Setter TargetName="RowChrome" Property="Background" Value="#FFFBFB"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>


                        <DataGrid.Columns>

                            <!-- EMPLOYEE -->
                            <DataGridTemplateColumn Header="EMPLOYEE" Width="2.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    Background="#E8F0FE"
                                                    CornerRadius="18"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmployeeName[0]}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0A3776"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding EmployeeName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0B2248"/>
                                                <TextBlock Text="Inside chamber"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ID CARD -->
                            <DataGridTemplateColumn Header="ID CARD" Width="0.95*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EmployeeId}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CHAMBER -->
                            <DataGridTemplateColumn Header="CHAMBER" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF5FF"
                                                BorderBrush="#BFDBFE"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChamberName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0A3776"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- IN TIME -->
                            <DataGridTemplateColumn Header="IN TIME" Width="1.45*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EntryTime, StringFormat={}{0:hh:mm:ss tt}}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0B2248"/>
                                            <TextBlock Text="{Binding EntryTime, StringFormat={}{0:dd MMM yyyy}}"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TIME REMAINING -->
                            <DataGridTemplateColumn Header="TIME REMAINING" Width="1.85*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="12,7"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Countdown}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="STATUS" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="11,5"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- VOICE -->
                            <DataGridTemplateColumn Header="VOICE" Width="0.95*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Stop"
                                                Width="70"
                                                Height="30"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Background="#DC2626"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="StopMemberVoice_Click"
                                                Visibility="{Binding ShowStopVoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="8,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            </Grid>

            </ScrollViewer>

