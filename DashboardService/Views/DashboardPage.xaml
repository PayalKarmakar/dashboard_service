                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F0F9FF" Offset="0"/>
                                                    <GradientStop Color="#E0F2FE" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="HUMIDITY"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="#0369A1"/>

                                                <TextBlock x:Name="HumidityValueText"
                                                Grid.Row="1"
                                                Text="--"
                                                FontSize="40"
                                                FontWeight="Bold"
                                                FontFamily="Bahnschrift"
                                                Foreground="#0284C7"
                                                VerticalAlignment="Center"
                                                Margin="0,4"/>

                                                <Border x:Name="HumidityStatusBorder"  
                                                Grid.Row="2"
                                                Background="#DCFCE7"
                                                BorderBrush="#4ADE80"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left">

                                                    <TextBlock x:Name="HumidityStatusText"
                                                    Text="NORMAL"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                        </Border>


                                        <!-- ================================= -->
                                        <!-- CO -->
                                        <!-- ================================= -->

                                        <Border x:Name="CoCardBorder"
                                        Grid.Column="4"
                                        CornerRadius="14"
                                        Padding="14"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1">

                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FEF2F2" Offset="0"/>
                                                    <GradientStop Color="#FEE2E2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="CO"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#B91C1C"/>

                                                <TextBlock x:Name="CoValueText"
                                            Grid.Row="1"
                                            Text="--"
                                            FontSize="40"
                                            FontWeight="Bold"
                                            FontFamily="Bahnschrift"
                                            Foreground="#DC2626"
                                            VerticalAlignment="Center"
                                            Margin="0,4"/>

                                                <Border x:Name="CoStatusBorder" 
                                                Grid.Row="2"
                                                Background="#DCFCE7"
                                                BorderBrush="#4ADE80"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left">

                                                    <TextBlock x:Name="CoStatusText"
                                                    Text="NORMAL"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                            Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                        </Border>


                                        <!-- ================================= -->
                                        <!-- CO2 -->
                                        <!-- ================================= -->

                                        <Border x:Name="Co2CardBorder"
                                        Grid.Column="6"
                                        CornerRadius="14"
                                        Padding="14"
                                        BorderBrush="#DDD6FE"
                                        BorderThickness="1">

                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FAF5FF" Offset="0"/>
                                                    <GradientStop Color="#F3E8FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="CO2"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#6D28D9"/>

                                                <TextBlock x:Name="Co2ValueText"
                                            Grid.Row="1"
                                            Text="--"
                                            FontSize="40"
                                            FontWeight="Bold"
                                            FontFamily="Bahnschrift"
                                            Foreground="#7C3AED"
                                            VerticalAlignment="Center"
                                            Margin="0,4"/>

                                                <Border x:Name="Co2StatusBorder"  
                                                Grid.Row="2"
                                                Background="#DCFCE7"
                                                BorderBrush="#4ADE80"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left">

                                                    <TextBlock x:Name="Co2StatusText"
                                            Text="NORMAL"
                                            FontSize="14"
                                            FontWeight="Bold"
                                                    Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                        </Border>


                                        <!-- ================================= -->
                                        <!-- OXYGEN -->
                                        <!-- ================================= -->

                                        <Border x:Name="OxygenCardBorder"
                                        Grid.Column="8"
                                        CornerRadius="14"
                                        Padding="14"
                                        BorderBrush="#BBF7D0"
                                        BorderThickness="1">

                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F0FDF4" Offset="0"/>
                                                    <GradientStop Color="#DCFCE7" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="OXYGEN"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="#166534"/>

                                                <TextBlock x:Name="OxygenValueText"
                                                Grid.Row="1"
                                                Text="--"
                                                FontSize="40"
                                                FontWeight="Bold"
                                                FontFamily="Bahnschrift"
                                                Foreground="#15803D"
                                                VerticalAlignment="Center"
                                                Margin="0,4"/>

                                                <Border x:Name="OxygenStatusBorder" 
                                                Grid.Row="2"
                                                Background="#DCFCE7"
                                                BorderBrush="#4ADE80"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left">

                                                    <TextBlock x:Name="OxygenStatusText"
                                            Text="NORMAL"
                                            FontSize="14"
                                            FontWeight="Bold"
                                                            Foreground="#166534"/>

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Border>



                            </Grid>


                            <Border Grid.Row="2"
				Margin="0,18,0,24"
				MinHeight="360"
				Background="{DynamicResource CardBgBrush}"
				CornerRadius="18"
				BorderBrush="{DynamicResource CardBorderBrush}"
				BorderThickness="1">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20"
                          ShadowDepth="2"
                          Opacity="0.09"
                          Color="#0A3776"/>
                                </Border.Effect>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>


                                    <!-- HEADER -->

                                    <Grid Grid.Row="0"
              Margin="24,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="Current Members"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>


                                             <TextBlock x:Name="CurrentMembersCountText"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="8,3,0,0"/>   
                                            </StackPanel>

                                                <TextBlock Text="Employees currently inside monitored chambers"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,5,0,0"/>   

                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                            <Button x:Name="StopAllVoiceButton"
                                    Content="Stop All Voice"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="StopAllVoice_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="ViewMoreMembersButton"
                                    Content="View More"
                                    Height="32"
                                    Padding="12,0"
                                    Background="#0A3776"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="ViewMoreMembers_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </StackPanel>

                                    </Grid>


                                    <!-- DATA GRID -->

                                    <DockPanel Grid.Row="1">
                                        <controls:PaginationBar x:Name="MembersPagerBar"
                                            DockPanel.Dock="Bottom"
                                            Margin="12,0,12,8"/>
                                        <DataGrid x:Name="MembersDataGrid"
                  Margin="12,0,12,0"
                  MinHeight="280"
                  MaxHeight="440"
                 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  VerticalGridLinesBrush="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  Background="{DynamicResource CardBgBrush}"
                  RowHeight="68"
                  FontSize="13"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FocusVisualStyle="{x:Null}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  HorizontalGridLinesBrush="Transparent">

                                            <DataGrid.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF2FC"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B2248"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF2FC"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B2248"/>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="DataGridRow">
                                                                <Border x:Name="RowChrome"
                                                    Margin="0,0,0,1"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#EEF2F7"
                                                    BorderThickness="0,0,0,1"
                                                    SnapsToDevicePixels="True">
                                                                    <Grid>
                                                                        <Border x:Name="StatusAccent"
                                                            Width="4"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            CornerRadius="2,0,0,2"/>
                                                                        <SelectiveScrollingGrid Margin="4,0,0,0">
                                                                            <SelectiveScrollingGrid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </SelectiveScrollingGrid.ColumnDefinitions>
                                                                            <DataGridCellsPresenter Grid.Column="1"
                                                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                                        </SelectiveScrollingGrid>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RowChrome" Property="Background" Value="#F8FBFF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="RowChrome" Property="Background" Value="#EAF2FC"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                        <Setter TargetName="StatusAccent" Property="Background" Value="#3B82F6"/>
                                                                        <Setter TargetName="RowChrome" Property="Background" Value="#F8FBFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                        <Setter TargetName="StatusAccent" Property="Background" Value="#F59E0B"/>
                                                                        <Setter TargetName="RowChrome" Property="Background" Value="#FFFCF5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                        <Setter TargetName="StatusAccent" Property="Background" Value="#EF4444"/>
                                                                        <Setter TargetName="RowChrome" Property="Background" Value="#FFFBFB"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="14,0"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>

                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Height" Value="44"/>
                                                    <Setter Property="Padding" Value="14,0"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                                <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGrid.Resources>


                                            <DataGrid.Columns>

                                                <!-- EMPLOYEE -->
                                                <DataGridTemplateColumn Header="EMPLOYEE" Width="2.3*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="44"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                    Width="36"
                                                    Height="36"
                                                    Background="#E8F0FE"
                                                    CornerRadius="18"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding EmployeeName[0]}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0A3776"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding EmployeeName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0B2248"/>
                                                                    <TextBlock Text="Inside chamber"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- ID CARD -->
                                                <DataGridTemplateColumn Header="ID CARD" Width="0.95*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F1F5F9"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EmployeeId}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- CHAMBER -->
                                                <DataGridTemplateColumn Header="CHAMBER" Width="1.35*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#EEF5FF"
                                                BorderBrush="#BFDBFE"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ChamberName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0A3776"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- IN TIME -->
                                                <DataGridTemplateColumn Header="IN TIME" Width="1.45*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EntryTime, StringFormat={}{0:hh:mm:ss tt}}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0B2248"/>
                                                                <TextBlock Text="{Binding EntryTime, StringFormat={}{0:dd MMM yyyy}}"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- TIME REMAINING -->
                                                <DataGridTemplateColumn Header="TIME REMAINING" Width="1.85*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="12,7"
                                                CornerRadius="9">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Countdown}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- STATUS -->
                                                <DataGridTemplateColumn Header="STATUS" Width="1.15*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="11,5"
                                                CornerRadius="9">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Attention">
                                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Alert">
                                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Violation">
                                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- VOICE -->
                                                <DataGridTemplateColumn Header="VOICE" Width="0.95*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Stop"
                                                Width="70"
                                                Height="30"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Background="#DC2626"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="StopMemberVoice_Click"
                                                Visibility="{Binding ShowStopVoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="8,0">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </DockPanel>

                                </Grid>

                            </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ========================================================= -->
                            <!-- DEVICE STATUS -->
                            <!-- Uses the EXISTING RFID + SENSOR status controls.          -->
                            <!-- No C# logic or existing x:Name values are changed.       -->
                            <!-- ========================================================= -->

                            <Border Grid.Row="0"
                                Background="White"
                                CornerRadius="16"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                ClipToBounds="True">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                           ShadowDepth="2"
                           Opacity="0.07"/>
                                </Border.Effect>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="72"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>


                                    <!-- ================================================= -->
                                    <!-- HEADER                                             -->
                                    <!-- ================================================= -->

                                    <Border Grid.Row="0"
                BorderBrush="#E8EDF3"
                BorderThickness="0,0,0,1"
                Padding="16,10">

                                        <Grid>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="Device Status"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#0B2248"/>

                                            </StackPanel>


                                            <!-- WIFI -->
                                            <Border Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#EFF6FF"
                        CornerRadius="9">

                                                <TextBlock Text="⌁"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                                            </Border>

                                        </Grid>

                                    </Border>


                                    <!-- ================================================= -->
                                    <!-- DEVICE LIST                                        -->
                                    <!-- ================================================= -->

                                    <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel>


                                            <!-- ================================================= -->
                                            <!-- CONNECTED RFID READERS                             -->
                                            <!-- ================================================= -->

                                            <ItemsControl x:Name="ConnectedReadersItemsControl">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Height="56"
                                    Padding="16,6"
                                    Background="White">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>


                                                                <!-- GREEN DOT -->
                                                                <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="#10B981"
                                             VerticalAlignment="Center"/>


                                                                <!-- DEVICE INFO -->
                                                                <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">

                                                                    <TextBlock Text="{Binding ReaderName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0B2248"/>

                                                                    <TextBlock Text="{Binding IpAddress}"
                                                   FontSize="10"
                                                   Foreground="#8BA0BC"
                                                   Margin="0,2,0,0"/>

                                                                </StackPanel>


                                                                <!-- ON -->
                                                                <Border Grid.Column="2"
                                            Background="#ECFDF5"
                                            BorderBrush="#6EE7B7"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,3"
                                            VerticalAlignment="Center">

                                                                    <TextBlock Text="ON"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#059669"/>

                                                                </Border>

                                                            </Grid>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>


                                            <!-- ================================================= -->
                                            <!-- DISCONNECTED RFID READERS                         -->
                                            <!-- ================================================= -->

                                            <ItemsControl x:Name="DisconnectedReadersItemsControl">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Height="56"
                                    Padding="16,6"
                                    Background="White">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>


                                                                <!-- RED DOT -->
                                                                <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="#FB7185"
                                             VerticalAlignment="Center"/>


                                                                <!-- DEVICE INFO -->
                                                                <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">

                                                                    <TextBlock Text="{Binding ReaderName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0B2248"/>

                                                                    <TextBlock Text="{Binding IpAddress}"
                                                   FontSize="10"
                                                   Foreground="#8BA0BC"
                                                   Margin="0,2,0,0"/>

                                                                </StackPanel>


                                                                <!-- OFF -->
                                                                <Border Grid.Column="2"
                                            Background="#FFF1F2"
                                            BorderBrush="#FDA4AF"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,3"
                                            VerticalAlignment="Center">

                                                                    <TextBlock Text="OFF"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#EF4444"/>

                                                                </Border>

                                                            </Grid>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>


                                            <!-- ================================================= -->
                                            <!-- CONNECTED SENSORS                                  -->
                                            <!-- ================================================= -->

                                            <ItemsControl x:Name="ConnectedSensorsItemsControl">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Height="56"
                                    Padding="16,6"
                                    Background="White">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>


                                                                <!-- GREEN DOT -->
                                                                <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="#10B981"
                                             VerticalAlignment="Center"/>


                                                                <!-- SENSOR INFO -->
                                                                <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">

                                                                    <TextBlock Text="{Binding SensorName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0B2248"/>

                                                                    <!--<TextBlock Text="{Binding LocationDisplay}"
                                                   FontSize="10"
                                                   Foreground="#8BA0BC"
                                                   Margin="0,2,0,0"/>-->

                                                                </StackPanel>


                                                                <!-- ON -->
                                                                <Border Grid.Column="2"
                                            Background="#ECFDF5"
                                            BorderBrush="#6EE7B7"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,3"
                                            VerticalAlignment="Center">

                                                                    <TextBlock Text="ON"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#059669"/>

                                                                </Border>

                                                            </Grid>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>


                                            <!-- ================================================= -->
                                            <!-- DISCONNECTED SENSORS                              -->
                                            <!-- ================================================= -->

                                            <ItemsControl x:Name="DisconnectedSensorsItemsControl">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Height="56"
                                    Padding="16,6"
                                    Background="White">

                                                            <Grid>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>


                                                                <!-- RED DOT -->
                                                                <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="#FB7185"
                                             VerticalAlignment="Center"/>


                                                                <!-- SENSOR INFO -->
                                                                <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">

                                                                    <TextBlock Text="{Binding SensorName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0B2248"/>

                                                                    <!--<TextBlock Text="{Binding LocationDisplay}"
                                                   FontSize="10"
                                                   Foreground="#8BA0BC"
                                                   Margin="0,2,0,0"/>-->

                                                                </StackPanel>


                                                                <!-- OFF -->
                                                                <Border Grid.Column="2"
                                            Background="#FFF1F2"
                                            BorderBrush="#FDA4AF"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,3"
                                            VerticalAlignment="Center">

                                                                    <TextBlock Text="OFF"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#EF4444"/>

                                                                </Border>

                                                            </Grid>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </ScrollViewer>

                                </Grid>

                            </Border>

                            <!-- ========================================================= -->
                            <!-- RIGHT : CAMERA VIOLATIONS                                  -->
                            <!-- ========================================================= -->

                            <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="16"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="16">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.06"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="Camera Violations"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Recent camera events"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#FEF2F2"
                                    CornerRadius="9"
                                    Padding="9,7">
                                            <TextBlock Text="CAM"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#DC2626"/>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="2"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">

                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="42"
                                        Height="42"
                                        Background="#FEF2F2"
                                        CornerRadius="21"
                                        HorizontalAlignment="Center">
                                                <TextBlock Text="CAM"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="No camera violations"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>

                                            <TextBlock Text="Camera violation data will appear here"
                                           FontSize="10"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>

                    </Grid>


                </Grid>

            </ScrollViewer>

        </Grid>

        <ItemsControl x:Name="ChambersItemsControl"
                      Visibility="Collapsed"/>
        <!-- DARK MODE BOOT OVERLAY -->
        <Border x:Name="SciFiBootOverlay"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Panel.ZIndex="9999"
                Background="#E0020612">

            <Grid>
                <Border x:Name="SciFiScanLine"
                        Height="3"
                        VerticalAlignment="Top"
                        Background="#AA22D3EE"
                        Opacity="0.85"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="SRP // SYSTEMS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#67E8F9"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SciFiBootTitle"
                               Text="DARK MODE ENGAGED"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#ECFEFF"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <TextBlock x:Name="SciFiBootSubtitle"
                               Text="Switching to dark interface..."
                               FontSize="14"
                               Foreground="#22D3EE"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <Border Width="280" Height="4" CornerRadius="2" Background="#164E63" Margin="0,24,0,0">
                        <Border x:Name="SciFiBootProgress"
                                Width="0"
                                Height="4"
                                CornerRadius="2"
                                Background="#22D3EE"
                                HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Page>