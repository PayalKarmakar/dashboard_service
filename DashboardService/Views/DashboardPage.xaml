<Page x:Class="DashboardService.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      FontFamily="Bahnschrift, Segoe UI"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ================================ -->
        <!-- COLORS / STYLES -->
        <!-- ================================ -->

        <Style x:Key="SidebarButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        BorderThickness="0">

                            <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{DynamicResource SidebarHoverBgBrush}"/>

                                <Setter Property="Foreground"
                                Value="{DynamicResource SidebarTextActiveBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- SIDEBAR TEXT -->
        <Style x:Key="SidebarExpandableTextStyle"  TargetType="TextBlock">

            <Setter Property="Visibility"
            Value="Collapsed"/>
            <Setter Property="VerticalAlignment"
            Value="Center"/>
            <Style.Triggers>

                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggleButton}"
                     Value="True">

                    <Setter Property="Visibility"
                    Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ================================ -->
        <!-- DATAGRID STYLE -->
        <!-- ================================ -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#F8FAFC"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E9EEF5"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="RowHeight"
                    Value="58"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="False"/>

            <Setter Property="FontSize"
                    Value="14"/>

        </Style>


        <!-- DATAGRID HEADER -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F7F9FC"/>

            <Setter Property="Foreground"
                    Value="#64748B"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="BorderBrush"
                    Value="#E7EDF4"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- DATAGRID CELL -->

        <Style TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

        </Style>


        <!-- DATAGRID ROW -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E9EEF5"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="DataGridRow">

                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <SelectiveScrollingGrid>

                                <SelectiveScrollingGrid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </SelectiveScrollingGrid.ColumnDefinitions>

                                <DataGridCellsPresenter
                                    Grid.Column="1"/>

                            </SelectiveScrollingGrid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#F5F9FF"/>

                            </Trigger>

                            <Trigger Property="AlternationIndex"
                                     Value="1">

                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#FAFBFD"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================ -->
        <!-- PROGRESS BAR -->
        <!-- ================================ -->

        <Style TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="8"/>

            <Setter Property="Background"
                    Value="#E7EDF4"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">

                            <Grid ClipToBounds="True">

                                <Border x:Name="PART_Track"
                                        CornerRadius="4"/>

                                <Border x:Name="PART_Indicator"
                                        Background="#0A3776"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>


    <!-- ===================================== -->
    <!-- MAIN LAYOUT -->
    <!-- ===================================== -->

    <Grid>

        <!--<Grid.ColumnDefinitions>

            <ColumnDefinition x:Name="SidebarColumn" Width="76"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================== -->



        <!-- ===================================== -->
        <!-- CONTENT -->
        <!-- ===================================== -->

        <Grid Margin="18,16,18,16"
                Background="{DynamicResource ContentAreaBgBrush}">

            <!-- Sci-fi atmosphere overlay -->
            <Border x:Name="ContentSciFiOverlay"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#1422D3EE" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <ScrollViewer Panel.ZIndex="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- HEADER -->
                        <RowDefinition Height="Auto"/>

                        <!-- HIDDEN SUMMARY REFERENCES -->
                        <RowDefinition Height="Auto"/>

                        <!-- RFID + SENSOR ALERTS -->
                        <RowDefinition Height="Auto"/>

                        <!-- MAIN TWO-COLUMN DASHBOARD -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ===================================== -->
                    <!-- HEADER -->
                    <!-- ===================================== -->

                    <Grid Grid.Row="0" Margin="0,0,0,14" Panel.ZIndex="1000">

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,320,0">
                            <TextBlock Text="OPERATIONS"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DashboardTitleText"
                                Text="Live Dashboard"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Margin="0,2,0,0"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                            <!-- ================================= -->
                            <!-- INSIDE CHAMBER -->
                            <!-- ================================= -->

                            <Border Width="250"
                                    Height="54"
                                    Background="{DynamicResource ProfileBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,6"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- PEOPLE ICON -->
                                    <Border Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            Background="#EAF2FB"
                                            CornerRadius="10"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="&#xE716;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="18"
                                            Foreground="#5F7897"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- COUNT -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">

                                        <TextBlock Text="Monitoring Camera"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"/>


                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="0"
                                                    FontSize="19"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                            <TextBlock Text="/5"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#8FA9C8"
                                                    VerticalAlignment="Bottom"
                                                    Margin="3,0,0,3"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <!-- ================================= -->
                            <!-- NOTIFICATION -->
                            <!-- ================================= -->

                            <Border Width="250"
                                    Height="54"
                                    Background="{DynamicResource ProfileBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,6"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center">

                                <Grid>

                                    <!-- BELL -->
                                    <Border Width="36"
                                            Height="36"
                                            Background="#245181"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="♧"
                                                FontSize="18"
                                                Foreground="#8FA9C8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- MINUS / VALUE -->
                                    <TextBlock Text="—"
                                            FontSize="20"
                                            Foreground="#7188A5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>

                                </Grid>

                            </Border>

                            <!-- DARK MODE TOGGLE -->
                            <Border x:Name="ThemeToggleButton"
                                    Width="172"
                                    Height="54"
                                    Background="{DynamicResource ProfileBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12,8"
                                    Margin="0,0,14,0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonUp="ThemeToggle_MouseLeftButtonUp">

                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ThemeToggleTrack"
                                        Width="42"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{DynamicResource ThemeToggleTrackBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                        <Border x:Name="ThemeToggleKnob"
                                            Width="16"
                                            Height="16"
                                            CornerRadius="8"
                                            Background="{DynamicResource ThemeToggleKnobBrush}"
                                            HorizontalAlignment="Left"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ThemeToggleLabel"
                                            Text="DARK MODE"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="ThemeToggleStateText"
                                            Text="OFF"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>




                            <!-- Profile container: relative positioning equivalent (Grid + Popup overlay) -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">

                                <!-- ADMINISTRATOR BUTTON -->

                                <Border x:Name="AdminMenuButton"
                                            Background="{DynamicResource ProfileBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="8"
                                            Cursor="Hand"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            MouseLeftButtonUp="AdminMenuButton_MouseLeftButtonUp">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                            ShadowDepth="2"
                                                            Opacity="0.06"/>
                                    </Border.Effect>

                                    <StackPanel Orientation="Horizontal">

                                        <Border Width="38"
                                                    Height="38"
                                                    Background="#0A3776"
                                                    CornerRadius="19">

                                            <TextBlock x:Name="AdminInitialText"
                                                        Text="A"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"
                                                        FontSize="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel Margin="10,0,8,0"
                                                        VerticalAlignment="Center">

                                            <TextBlock x:Name="AdminNameText"
                                                        Text="Administrator"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <TextBlock x:Name="AdminRoleText"
                                                        Text="ADMIN"
                                                        FontSize="9"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Margin="0,2,0,0"/>

                                        </StackPanel>

                                        <TextBlock x:Name="AdminMenuArrow"
                                                    Text="&#x25BC;"
                                                    FontSize="9"
                                                    Foreground="#8793A3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,4,0"/>

                                    </StackPanel>

                                </Border>


                                <!-- OVERLAY MENU: floats above dashboard, does not affect layout flow -->

                                <Popup x:Name="AdminMenuPopup"
                                        PlacementTarget="{Binding ElementName=AdminMenuButton}"
                                        Placement="Bottom"
                                        VerticalOffset="8"
                                        AllowsTransparency="True"
                                        StaysOpen="True"
                                        PopupAnimation="Fade"
                                        Closed="AdminMenuPopup_Closed">

                                    <Border x:Name="AdminMenuPanel"
                                                Width="230"
                                                Background="{DynamicResource ModalCardBrush}"
                                                CornerRadius="14"
                                                Padding="8"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18"
                                                                ShadowDepth="3"
                                                                Opacity="0.14"/>
                                        </Border.Effect>

                                        <StackPanel>

                                            <Button Click="Logout_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="10,10"
                                                        HorizontalContentAlignment="Left"
                                                        Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                            Property="Background"
                                                                            Value="#FEF2F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32"
                                                                Height="32"
                                                                Background="#FEF2F2"
                                                                CornerRadius="8"
                                                                Margin="0,0,12,0">
                                                        <TextBlock Text="OUT"
                                                                    FontSize="9"
                                                                    FontWeight="Bold"
                                                                    Foreground="#DC2626"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Logout"
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#DC2626"/>
                                                        <TextBlock Text="Sign out from dashboard"
                                                                    FontSize="11"
                                                                    Foreground="#94A3B8"
                                                                    Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                        </StackPanel>

                                    </Border>

                                </Popup>

                            </Grid>

                        </StackPanel>

                    </Grid>

                    <!-- ===================================== -->
                    <!-- SUMMARY CARD CODE-BEHIND REFERENCES AS upper part is commented for now-->
                    <!-- ===================================== -->

                    <StackPanel Grid.Row="1" Visibility="Collapsed">

                        <!-- Existing dashboard summary references -->
                        <TextBlock x:Name="MembersInsideText" Text="0"/>
                        <TextBlock x:Name="ActiveChambersText" Text="0"/>
                        <TextBlock x:Name="AlertsText" Text="0"/>
                        <TextBlock x:Name="ViolationsText" Text="0"/>

                        <!-- RFID STATUS CODE-BEHIND REFERENCES -->
                        <TextBlock x:Name="RfidLastCheckedText"
               Text="Last checked: --"/>

                        <TextBlock x:Name="RfidServiceStatusText"
               Text=""/>

                        <TextBlock x:Name="ConnectedReadersCountText"
               Text="(0)"/>

                        <TextBlock x:Name="DisconnectedReadersCountText"
               Text="(0)"/>

                        <TextBlock x:Name="NoConnectedReadersText"
               Text="No RFID readers connected."
               Visibility="Collapsed"/>

                        <TextBlock x:Name="NoDisconnectedReadersText"
               Text="All RFID readers are connected."
               Visibility="Collapsed"/>

                        <!-- SENSOR STATUS CODE-BEHIND REFERENCES -->
                        <TextBlock x:Name="SensorLastCheckedText"
               Text="Last checked: --"/>

                        <TextBlock x:Name="SensorServiceStatusText"
               Text=""/>

                        <TextBlock x:Name="ConnectedSensorsCountText"
               Text="(0)"/>

                        <TextBlock x:Name="DisconnectedSensorsCountText"
               Text="(0)"/>

                        <TextBlock x:Name="NoConnectedSensorsText"
               Text="No sensors connected."
               Visibility="Collapsed"/>

                        <TextBlock x:Name="NoDisconnectedSensorsText"
               Text="All sensors are connected."
               Visibility="Collapsed"/>

                    </StackPanel>


                    <!-- ============================================================ -->
                    <!-- FIGMA CONTENT LAYOUT ONLY                                     -->
                    <!-- HEADER ABOVE IS UNCHANGED                                     -->
                    <!-- ============================================================ -->

                    <Grid Grid.Row="2"
                  Margin="0,8,0,24">

                        <Grid.ColumnDefinitions>
                            <!-- Figma: approximately 75% -->
                            <ColumnDefinition Width="3*"/>

                            <!-- gap -->
                            <ColumnDefinition Width="18"/>

                            <!-- Figma: approximately 25% -->
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <Grid Grid.Column="0" Grid.Row="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>


                                <!-- SENSOR MONITORING HEADING -->

                                <Grid Grid.Row="0" Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- TITLE -->

                                    <StackPanel VerticalAlignment="Center">

                                        <TextBlock Text="Sensor Monitoring"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    </StackPanel>


                                    <!-- VOICE LANG + SENSOR VOICE + LIVE -->

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"  VerticalAlignment="Center">

                                        <!-- Voice language -->
                                        <Border Background="#F1F5F9"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Margin="0,0,8,0"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Voice"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="#64748B"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"/>
                                                <RadioButton x:Name="VoiceLangEnglishRadio"
                                                    Content="English"
                                                    GroupName="DashboardVoiceLang"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#0A3776"
                                                    IsChecked="True"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Checked="VoiceLanguageRadio_Checked"/>
                                                <RadioButton x:Name="VoiceLangBengaliRadio"
                                                    Content="বাংলা"
                                                    GroupName="DashboardVoiceLang"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#0A3776"
                                                    VerticalAlignment="Center"
                                                    Checked="VoiceLanguageRadio_Checked"/>
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="StopSensorVoiceButton"
                                        Content="Stop Voice"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,6,0"
                                        Background="#DC2626"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="StopSensorVoice_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="StartSensorVoiceButton"
                                        Content="Start Voice"
                                        Height="28"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        Background="#16A34A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        IsEnabled="False"
                                        Click="StartSensorVoice_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}"
                                                    Opacity="{TemplateBinding Opacity}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>

                                </Grid>


                                <!-- SENSOR CARD CONTAINER -->
                                <Border Grid.Row="1"
                                Background="White"
                                CornerRadius="16"
                                Padding="16"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                MinHeight="210">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                            ShadowDepth="3"
                            Opacity="0.06"/>
                                    </Border.Effect>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- ================================= -->
                                        <!-- TEMPERATURE -->
                                        <!-- ================================= -->

                                        <Border x:Name="TemperatureCardBorder"
                                        Grid.Column="0"
                                        CornerRadius="14"
                                        Padding="14"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1">

                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFF7ED" Offset="0"/>
                                                    <GradientStop Color="#FFEDD5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
