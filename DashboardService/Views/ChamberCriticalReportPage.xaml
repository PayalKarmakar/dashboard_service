<Page x:Class="DashboardService.Views.ChamberCriticalReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">


        <ScrollViewer
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chamber Critical Situation Report" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="When chambers had WARNING or CRITICAL sensor violations and for how long" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="ExportButton"
                        Content="Export CSV"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Export_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="FromDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ToDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Chamber" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ChamberComboBox"
                                  Height="36"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="ChamberId"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Parameter" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ParameterTextBox"
                                 Height="36"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 KeyDown="SearchTextBox_KeyDown"/>
                    </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Severity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SeverityComboBox"
                                      Height="36"
                                      SelectedIndex="0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All (Warning + Critical)" Tag=""/>
                                <ComboBoxItem Content="Warning" Tag="WARNING"/>
                                <ComboBoxItem Content="Critical" Tag="CRITICAL"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2"
                            Content="Search"
                            Width="110"
                            Height="36"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Search_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ResultCountText"
                               Margin="10,6,10,10"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="0 records"/>

                    <DockPanel Grid.Row="1">
                    <controls:PaginationBar x:Name="ReportPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="ReportGrid"
                              MinHeight="320"
                              MaxHeight="520"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="{DynamicResource CardBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              RowBackground="{DynamicResource CardBgBrush}"
                              AlternatingRowBackground="{DynamicResource AltRowBgBrush}"
                              HorizontalGridLinesBrush="{DynamicResource GridLineBrush}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource DataGridHeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderFgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="1.1*"/>
                            <DataGridTextColumn Header="SEVERITY" Binding="{Binding SeverityDisplay}" Width="0.8*"/>
                            <DataGridTextColumn Header="PARAMETER" Binding="{Binding Parameter}" Width="0.8*"/>
                            <DataGridTextColumn Header="ACTUAL" Binding="{Binding ValueDisplay}" Width="0.8*"/>
                            <DataGridTextColumn Header="THRESHOLD" Binding="{Binding ThresholdDisplay}" Width="0.8*"/>
                            <DataGridTextColumn Header="STARTED AT" Binding="{Binding StartedDisplay}" Width="1.4*"/>
                            <DataGridTextColumn Header="ENDED AT" Binding="{Binding EndedDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="DURATION" Binding="{Binding DurationDisplay}" Width="0.9*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay}" Width="0.8*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
</Page>
