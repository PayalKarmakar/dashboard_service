<Page x:Class="DashboardService.Views.LiveCameraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarHost" Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="14,10,14,0">
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="LiveCameraMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Camera" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraAccessReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera Access" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorReadingsReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor Readings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ConfigurationToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ConfigurationArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleButton"
                            Content="«"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            FontSize="16"
                            Cursor="Hand"
                            Background="{DynamicResource ButtonSecondaryBgBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Click="SidebarToggle_Click"
                            ToolTip="Minimize sidebar"/>
                    <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Live Camera" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="LiveCameraSubtitleText"
                               Text="Stream stats beside the camera"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="CameraComboBox"
                              Width="260"
                              Height="42"
                              Margin="0,0,10,0"
                              DisplayMemberPath="DisplayLabel"
                              SelectionChanged="CameraComboBox_SelectionChanged"/>
                    <Button x:Name="StartButton"
                            Content="Start Stream"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="StartButton_Click"/>
                    <Button x:Name="StopButton"
                            Content="Stop"
                            Width="90"
                            Height="42"
                            Background="{DynamicResource ButtonSecondaryBgBrush}"
                            Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            IsEnabled="False"
                            Click="StopButton_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="DoorAlertBanner"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    Padding="14,10"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DoorAlertTitleText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#7F1D1D"/>
                        <TextBlock x:Name="DoorAlertMessageText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="#991B1B"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Dismiss"
                            Height="32"
                            Padding="12,0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="DismissDoorAlert_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12">
                    <Grid>
                        <Image x:Name="StreamImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <Border Background="#AA000000"
                                CornerRadius="10"
                                Padding="10,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8">
                            <TextBlock x:Name="StreamStatusText"
                                       Text="Select a camera and click Start Stream"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="DetectedStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetectedTitleText" Text="PERSONS INSIDE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetectedCountText" Text="0" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DetectedHintText"
                                       Text="People currently detected in chamber"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EntryStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ENTRY PERSONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsideCountText" Text="0" FontSize="34" FontWeight="Bold" Foreground="#4CD964" Margin="0,6,0,0"/>
                            <TextBlock Text="Crossed line going inside (IN)"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ExitStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="EXIT PERSONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="OutsideCountText" Text="0" FontSize="34" FontWeight="Bold" Foreground="#FF8C42" Margin="0,6,0,0"/>
                            <TextBlock Text="Crossed line going outside (OUT)"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="UnauthorizedStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="UNAUTHORIZED ENTRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="UnauthorizedCountText" Text="0" FontSize="34" FontWeight="Bold" Foreground="#FF3B30" Margin="0,6,0,0"/>
                            <TextBlock Text="No RFID / tailgate this session"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ACCURACY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="AccuracyText" Text="0%" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="Average detection confidence"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RfidStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="RFID INSIDE (VERIFIED)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RfidInsideText" Text="0" FontSize="34" FontWeight="Bold" Foreground="#5AC8FA" Margin="0,6,0,0"/>
                            <TextBlock x:Name="RfidChamberText"
                                       Text="Employees with open RFID entry"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="VerifyStatCard" Style="{StaticResource StatCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="VerifyStatusTitleText" Text="DOOR VERIFY STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="DoorVerifyStatusText"
                                       Text="Idle"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FPS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="FpsText" Text="0.0 fps" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DetectionModeText"
                                       Text="Person detection: Off"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
