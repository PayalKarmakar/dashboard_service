<Page x:Class="DashboardService.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EEF3F9">

    <Page.Resources>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#DCE5F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#0A3776"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  ShadowDepth="3"
                                                  Opacity="0.22"
                                                  Color="#0A3776"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#174D8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#082A58"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0A3776"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="#174D8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*"/>
            <ColumnDefinition Width="0.92*"/>
        </Grid.ColumnDefinitions>


        <!-- LEFT BRAND PANEL -->
        <Grid Grid.Column="0" ClipToBounds="True">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#061F45" Offset="0"/>
                    <GradientStop Color="#0A3776" Offset="0.48"/>
                    <GradientStop Color="#1D5FA8" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse Width="460" Height="460"
                     Fill="#18FFFFFF"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-180,-200,0,0"
                     IsHitTestVisible="False"/>

            <Ellipse Width="320" Height="320"
                     Fill="#12FFFFFF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-110,-90"
                     IsHitTestVisible="False"/>

            <Border Width="200" Height="200"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="100"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,80,-60,0"
                    IsHitTestVisible="False"/>

            <StackPanel VerticalAlignment="Center" Margin="72,0,48,0">

                <Border Width="64" Height="64"
                        Background="#22FFFFFF"
                        CornerRadius="16"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,24"
                        Padding="8">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Border Background="#1AFFFFFF"
                        CornerRadius="20"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18">
                    <TextBlock Text="SECURE ACCESS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#B8D7F7"/>
                </Border>

                <TextBlock Text="SRP INNOVATIONS"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#9FC8F5"/>

                <TextBlock Text="Smart Chamber"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,12,0,0"/>

                <TextBlock Text="Monitoring"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="Secure access for chamber occupancy, employee tracking and live safety alerts."
                           FontSize="15"
                           Foreground="#C5D8F0"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           Margin="0,18,48,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,36,0,0">

                    <Border Background="#1AFFFFFF" CornerRadius="12" Padding="14,11" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#86EFAC"/>
                            <TextBlock Text="Occupancy" FontSize="12" Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1AFFFFFF" CornerRadius="12" Padding="14,11" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="RFID" FontSize="10" FontWeight="Bold" Foreground="#93C5FD"/>
                            <TextBlock Text="Access" FontSize="12" Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1AFFFFFF" CornerRadius="12" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="ALERT" FontSize="10" FontWeight="Bold" Foreground="#FCD34D"/>
                            <TextBlock Text="Safety" FontSize="12" Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>

            <TextBlock FontSize="11"
                       Foreground="#7FA3D0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="72,0,0,36">
                <Run Text="Designed &amp; Developed by "/>
                <Hyperlink NavigateUri="https://codeinq.com/"
                           RequestNavigate="CodeInqLink_RequestNavigate"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           TextDecorations="Underline"
                           Cursor="Hand">
                    <Run Text="CodeInQ"/>
                </Hyperlink>
            </TextBlock>

        </Grid>


        <!-- RIGHT LOGIN FORM -->
        <Grid Grid.Column="1" Background="#EEF3F9">

            <Border Width="440"
                    Padding="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border Background="White"
                        CornerRadius="22"
                        Padding="40,36">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32"
                                          ShadowDepth="6"
                                          Opacity="0.12"
                                          Color="#0A3776"/>
                    </Border.Effect>

                    <StackPanel>

                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="#EFF6FF"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Padding="8">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="Welcome back"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#0A3776"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Sign in"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,6"/>

                        <TextBlock Text="Enter your credentials to open the dashboard"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,26"/>


                        <TextBlock Text="User ID" Style="{StaticResource FieldLabelStyle}"/>

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="👤"
                                           FontSize="14"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="UserIdTextBox"
                                         Grid.Column="1"
                                         FontSize="15"
                                         Foreground="#0F172A"
                                         CaretBrush="#0A3776"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,14,0"
                                         KeyDown="LoginFields_KeyDown"/>
                            </Grid>
                        </Border>


                        <Grid Margin="0,18,0,8">
                            <TextBlock Text="Password"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource InputBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔒"
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <PasswordBox x:Name="PasswordTextBox"
                                             Grid.Column="1"
                                             FontSize="15"
                                             Foreground="#0F172A"
                                             CaretBrush="#0A3776"
                                             VerticalContentAlignment="Center"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0,0,8,0"
                                             KeyDown="LoginFields_KeyDown"/>

                                <TextBox x:Name="VisiblePasswordTextBox"
                                         Grid.Column="1"
                                         FontSize="15"
                                         Foreground="#0F172A"
                                         CaretBrush="#0A3776"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,8,0"
                                         Visibility="Collapsed"
                                         KeyDown="LoginFields_KeyDown"/>

                                <Button x:Name="PasswordEyeButton"
                                        Grid.Column="2"
                                        Content="👁"
                                        FontSize="14"
                                        Foreground="#94A3B8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False"
                                        ToolTip="Show password"
                                        Click="TogglePasswordVisibility_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>


                        <Button x:Name="LoginButton"
                                Content="Sign in to Dashboard"
                                Style="{StaticResource LoginButtonStyle}"
                                Margin="0,26,0,0"
                                Click="LoginButton_Click"/>

                        <Button Content="Change password"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Click="ChangePasswordLink_Click"/>


                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="0,1,0,0"
                                Margin="0,28,0,0"
                                Padding="0,16,0,0">

                            <StackPanel>
                                <TextBlock Text="© 2026 SRP Innovations. All rights reserved."
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"/>

                                <TextBlock FontSize="11"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0">
                                    <Run Text="Designed &amp; Developed by "/>
                                    <Hyperlink NavigateUri="https://codeinq.com/"
                                               RequestNavigate="CodeInqLink_RequestNavigate"
                                               Foreground="#1565C0"
                                               FontWeight="SemiBold"
                                               TextDecorations="Underline"
                                               Cursor="Hand">
                                        <Run Text="CodeInQ"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Border>

        </Grid>

    </Grid>

</Page>
