<Page x:Class="DashboardService.Views.ProductionLossReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">


        <ScrollViewer
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Production Loss Report" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="How long production was lost during WARNING or CRITICAL sensor violations" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="ExportButton"
                        Content="Export CSV"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Export_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="FromDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ToDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Chamber" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ChamberComboBox"
                                  Height="36"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="ChamberId"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <Button Grid.Column="6"
                            Content="Search"
                            Width="110"
                            Height="36"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Search_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="10,6,10,10">
                        <TextBlock x:Name="ResultCountText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="0 records"/>
                        <TextBlock x:Name="SummaryText"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <DockPanel Grid.Row="1">
                    <controls:PaginationBar x:Name="ReportPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="ReportGrid"
                              MinHeight="320"
                              MaxHeight="520"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="{DynamicResource CardBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              RowBackground="{DynamicResource CardBgBrush}"
                              AlternatingRowBackground="{DynamicResource AltRowBgBrush}"
                              HorizontalGridLinesBrush="{DynamicResource GridLineBrush}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource DataGridHeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderFgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CHAMBER CODE" Binding="{Binding ChamberCode}" Width="0.9*"/>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="1.3*"/>
                            <DataGridTextColumn Header="LOSS STARTED" Binding="{Binding StartedDisplay}" Width="1.5*"/>
                            <DataGridTextColumn Header="LOSS ENDED" Binding="{Binding EndedDisplay}" Width="1.3*"/>
                            <DataGridTextColumn Header="LOST TIME" Binding="{Binding DurationDisplay}" Width="0.9*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
</Page>
