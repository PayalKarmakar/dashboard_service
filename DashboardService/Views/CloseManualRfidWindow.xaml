<Window x:Class="DashboardService.Views.CloseManualRfidWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual RFID Close"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="20"
            Background="{DynamicResource ModalCardBrush}"
            CornerRadius="16"
            Padding="24,20"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Close RFID Transaction"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Manually mark exit for an open RFID entry"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,18"/>

            <TextBlock Text="Employee" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="EmployeeText"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Chamber" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="ChamberText"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Remarks (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="RemarksTextBox"
                     Height="38"
                     Margin="0,0,0,4"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"
                     Text="Manual close"/>
            <TextBlock Text="Defaults to “Manual close” if cleared"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Cancel_Click"/>
                <Button Content="Close Entry"
                        Width="120"
                        Height="38"
                        Background="#FF3B30"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
