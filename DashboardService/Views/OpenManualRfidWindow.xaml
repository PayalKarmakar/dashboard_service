<Window x:Class="DashboardService.Views.OpenManualRfidWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual RFID Open"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="20"
            Background="{DynamicResource ModalCardBrush}"
            CornerRadius="16"
            Padding="24,20"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Open RFID Transaction"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Manually mark an employee as inside a chamber"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,18"/>

            <TextBlock Text="Employee *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="EmployeeComboBox"
                      Height="38"
                      Margin="0,0,0,14"
                      DisplayMemberPath="Display"
                      SelectedValuePath="EmployeeId"/>

            <TextBlock Text="Chamber *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="ChamberComboBox"
                      Height="38"
                      Margin="0,0,0,18"
                      DisplayMemberPath="Display"
                      SelectedValuePath="ChamberId"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Cancel_Click"/>
                <Button Content="Open Entry"
                        Width="120"
                        Height="38"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
