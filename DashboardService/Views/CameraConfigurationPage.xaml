<Page x:Class="DashboardService.Views.CameraConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel Margin="14,10,14,0">
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Employees" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Background="{DynamicResource SidebarActiveBgBrush}"
                                Foreground="{DynamicResource SidebarTextActiveBrush}"
                                Click="ConfigurationToggle_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ConfigurationArrowText" Text="▲" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Visible">
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorConfigurationMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="CameraConfigurationMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Camera" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Camera Configuration" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Camera settings will be configured here."
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
                <Border Margin="0,24,0,0"
                        Padding="24"
                        CornerRadius="16"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Width="420">
                        <TextBlock Text="Coming soon" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Add camera IP, stream URL, chamber mapping, and alert rules in the next step."
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
