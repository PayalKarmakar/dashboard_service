<Window x:Class="DashboardService.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="28,24"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="PW" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Change Password" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Choose a strong password for your account" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="User ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
            <TextBox x:Name="UserIdTextBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FieldBox}"/>

            <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FieldBox}" Margin="0,0,0,8"/>

            <TextBlock Text="Password must be at least 6 characters."
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        Cursor="Hand" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Update Password" Width="150" Height="40"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
