<Page x:Class="DashboardService.Views.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">


        <Grid Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Employees" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Add employees and map RFID cards to chambers" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="AddEmployeeButton"
                        Content="Add Employee"
                        Width="150"
                        Height="42"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="AddEmployee_Click"/>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8">
                <DockPanel>
                <controls:PaginationBar x:Name="EmployeesPagerBar" DockPanel.Dock="Bottom"/>
                <DataGrid x:Name="EmployeesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="{DynamicResource CardBgBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          RowBackground="{DynamicResource CardBgBrush}"
                          AlternatingRowBackground="{DynamicResource AltRowBgBrush}"
                          HorizontalGridLinesBrush="{DynamicResource GridLineBrush}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderFgBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="42"/>
                            <Setter Property="Padding" Value="12,0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                        <Style x:Key="DataGridTextCellStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CODE" Binding="{Binding EmployeeCode}" Width="0.8*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="NAME" Binding="{Binding EmployeeName}" Width="1.3*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="CARD UID" Binding="{Binding CardUid}" Width="*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="DESIGNATION" Binding="{Binding Designation}" Width="*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="MOBILE" Binding="{Binding Mobile}" Width="*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.7*" ElementStyle="{StaticResource DataGridTextCellStyle}"/>
                        <DataGridTemplateColumn Header="ACTION" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ToggleActionText}"
                                                Padding="8,4"
                                                Margin="4,2"
                                                Cursor="Hand"
                                                Click="ToggleActive_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLost}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding LostActionText}"
                                                Padding="8,4"
                                                Margin="4,2"
                                                Cursor="Hand"
                                                Click="ToggleLost_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLost}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
</Page>
