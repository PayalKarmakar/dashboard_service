<Page x:Class="DashboardService.Views.CameraAccessReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">


        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Camera Access Report" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="No RFID violations only (camera entry/exit without RFID scan)"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Export CSV"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Export_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="FromDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ToDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="4"
                            Content="Search"
                            Width="110"
                            Height="36"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Search_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="NO RFID ENTRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryEntryText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF3B30" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="NO RFID EXIT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryExitText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF8C42" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL NO RFID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryUnauthorizedText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF3B30" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DockPanel>
                <controls:PaginationBar x:Name="EventsPagerBar" DockPanel.Dock="Bottom"/>
                <DataGrid x:Name="EventsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource TableAltRowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE / TIME" Binding="{Binding OccurredDisplay}" Width="1.4*"/>
                        <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="*"/>
                        <DataGridTextColumn Header="CAMERA" Binding="{Binding CameraName}" Width="*"/>
                        <DataGridTextColumn Header="EVENT" Binding="{Binding EventDisplay}" Width="1.3*"/>
                        <DataGridTextColumn Header="PERSONS" Binding="{Binding PersonCount}" Width="0.7*"/>
                        <DataGridTextColumn Header="RFID" Binding="{Binding RfidDisplay}" Width="0.6*"/>
                        <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
</Page>
