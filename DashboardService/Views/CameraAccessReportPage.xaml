<Page x:Class="DashboardService.Views.CameraAccessReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="14,10,14,0">
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="LiveCameraMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Camera" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="ReportsToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reports" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ReportsArrowText" Text="▲" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}"
                                        Height="40"
                                        Background="{DynamicResource SidebarActiveBgBrush}"
                                        Foreground="{DynamicResource SidebarTextActiveBrush}"
                                        Click="CameraAccessReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera Access" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorReadingsReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor Readings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ConfigurationToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ConfigurationArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Camera Access Report" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Entry / Exit crossings and unauthorized entry violations with date &amp; time"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Export CSV"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Export_Click"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="FromDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ToDatePicker" Height="36" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Event Type" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="EventComboBox"
                                  Height="36"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Entry" Tag="ENTRY"/>
                            <ComboBoxItem Content="Exit" Tag="EXIT"/>
                            <ComboBoxItem Content="Unauthorized" Tag="UNAUTHORIZED"/>
                            <ComboBoxItem Content="Verified" Tag="MATCHED"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="6"
                            Content="Search"
                            Width="110"
                            Height="36"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Search_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL ENTRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryEntryText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#4CD964" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL EXIT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryExitText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF8C42" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="UNAUTHORIZED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="SummaryUnauthorizedText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF3B30" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DataGrid x:Name="EventsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource TableAltRowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE / TIME" Binding="{Binding OccurredDisplay}" Width="1.4*"/>
                        <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="*"/>
                        <DataGridTextColumn Header="CAMERA" Binding="{Binding CameraName}" Width="*"/>
                        <DataGridTextColumn Header="EVENT" Binding="{Binding EventDisplay}" Width="1.3*"/>
                        <DataGridTextColumn Header="PERSONS" Binding="{Binding PersonCount}" Width="0.7*"/>
                        <DataGridTextColumn Header="RFID" Binding="{Binding RfidDisplay}" Width="0.6*"/>
                        <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="2.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>
