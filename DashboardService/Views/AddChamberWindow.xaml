<Window x:Class="DashboardService.Views.AddChamberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Chamber"
        Width="980"
        MinWidth="900"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="16" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="20,16"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Add Chamber" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Create a new monitored chamber" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Chamber Code *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="CodeTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Chamber Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="NameTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="LocationTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Member Threshold" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="MemberThresholdTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time Threshold (minutes) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="TimeThresholdTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource ModalStepBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Half-time — minutes from entry"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Alert after this many minutes from entry. Default = half of Time Threshold."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minutes from entry" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="HalfTimeMinutesTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Play count" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="HalfTimePlayCountTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="HalfTimeAudioCheckBox" Content="Play half-time audio" IsChecked="True"
                                  Margin="0,8,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Message (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="HalfTimeMessageTextBox" Height="44" Margin="0,4,0,4" Padding="8,6"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <TextBlock x:Name="HalfTimeExampleText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource ModalStepBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Warning — minutes before threshold"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Status and audio start this many minutes before permitted time expires."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minutes before" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="WarningBeforeTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Play count" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox x:Name="WarningPlayCountTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="WarningAudioCheckBox" Content="Play warning audio" IsChecked="True"
                                  Margin="0,8,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Message (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox x:Name="WarningMessageTextBox" Height="44" Margin="0,4,0,4" Padding="8,6"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <TextBlock x:Name="WarningExampleText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource ModalStepBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Violation — minutes after time threshold"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="0 = at expiry. Restart after Stop = repeat_after_minutes (how long after Stop the next session starts)."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minutes after" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ViolationAfterTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Play count" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ViolationPlayCountTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            <TextBlock Text="continue or 1, 2, 3…"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Restart after Stop (minutes) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBox x:Name="RestartAfterStopTextBox" Height="34" Margin="0,4,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            <TextBlock Text="Saved as repeat_after_minutes"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ViolationAudioCheckBox" Content="Play violation audio" IsChecked="True"
                              Margin="0,10,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Message (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="ViolationMessageTextBox" Height="44" Margin="0,4,0,4" Padding="8,6"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock x:Name="ViolationExampleText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SystemDefinitionText"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       LineHeight="16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="110" Height="38" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
