<Window x:Class="DashboardService.Views.AddChamberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Chamber"
        Width="560"
        MaxHeight="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="20" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="24,20"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="740">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Add Chamber" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Create a new monitored chamber" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,16"/>

            <TextBlock Text="Chamber Code *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="CodeTextBox" Height="40" Margin="0,6,0,12" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Chamber Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="NameTextBox" Height="40" Margin="0,6,0,12" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="LocationTextBox" Height="40" Margin="0,6,0,12" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Member Threshold" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="MemberThresholdTextBox" Height="40" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time Threshold (minutes) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="TimeThresholdTextBox" Height="40" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource ModalStepBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Warning — minutes before time threshold"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Status and audio start this many minutes before permitted time expires."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minutes before" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="WarningBeforeTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Play count" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="WarningPlayCountTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="WarningAudioCheckBox" Content="Play warning audio" IsChecked="True"
                              Margin="0,10,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="Warning message (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="WarningMessageTextBox"
                             MinHeight="56"
                             Margin="0,6,0,4"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock x:Name="WarningExampleText"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ModalStepBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Violation — minutes after time threshold"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Status and audio start this many minutes after permitted time expires. 0 = at expiry."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minutes after" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ViolationAfterTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Play count" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ViolationPlayCountTextBox" Height="36" Margin="0,6,0,0" Padding="10,0" VerticalContentAlignment="Center"
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            <TextBlock Text="Type continue or a number (1, 2, 3…)"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ViolationAudioCheckBox" Content="Play violation audio" IsChecked="True"
                              Margin="0,10,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="Violation message (optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="ViolationMessageTextBox"
                             MinHeight="56"
                             Margin="0,6,0,4"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock x:Name="ViolationExampleText"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ModalStepBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NB — system definition"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="SystemDefinitionText"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               LineHeight="16"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="110" Height="40" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
