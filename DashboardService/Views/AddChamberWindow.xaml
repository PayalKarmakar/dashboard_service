<Window x:Class="DashboardService.Views.AddChamberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Chamber"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="24" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="28,24"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Add Chamber" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Create a new monitored chamber" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,18"/>

            <TextBlock Text="Chamber Code *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="CodeTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Chamber Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="NameTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="LocationTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Member Threshold" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="MemberThresholdTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Time Threshold (minutes)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="TimeThresholdTextBox" Height="40" Margin="0,6,0,20" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" Click="Cancel_Click"/>
                <Button Content="Save" Width="110" Height="40" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
