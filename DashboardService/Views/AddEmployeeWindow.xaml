<Window x:Class="DashboardService.Views.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Employee"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        Closing="Window_Closing">

    <Window.Resources>
        <Storyboard x:Key="LoaderSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoaderRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.9"/>
        </Storyboard>

        <!-- Primary Save: custom template so navy + white stay visible (incl. disabled). -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="Transparent" Grid.ColumnSpan="2"/>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 6 6 L 12 0"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="1.5"
                                                      Fill="Transparent"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="12,0,36,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontStretch="{TemplateBinding FontStretch}"
                                              TextElement.FontStyle="{TemplateBinding FontStyle}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ModalCardBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,2,0,0"
                                        Padding="0,4">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="28,24"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Add Employee" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Choose a card reader from the list, then click Wait for Punch. Manual Card UID entry is not allowed."
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,16"
                       TextWrapping="Wrap"/>

            <!-- Step 1: reader + punch -->
            <Border Background="{DynamicResource ModalStepBgBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Step 1: Card reader &amp; RFID punch"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Text="Card reader *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,10,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="RegistrationReaderComboBox"
                                  Grid.Column="0"
                                  Height="40"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  IsEditable="False"
                                  MaxDropDownHeight="220"
                                  DisplayMemberPath="Label"
                                  Cursor="Hand"
                                  SelectionChanged="RegistrationReaderComboBox_SelectionChanged"/>

                        <Button x:Name="StartScanButton"
                                Grid.Column="2"
                                Content="Wait for Punch"
                                MinWidth="130"
                                Height="40"
                                Padding="14,0"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                IsEnabled="False"
                                Click="StartScanButton_Click"/>
                    </Grid>

                    <!-- Loader while waiting for punch -->
                    <StackPanel x:Name="WaitingPanel"
                                Orientation="Horizontal"
                                Margin="0,4,0,8"
                                Visibility="Collapsed">
                        <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="28" Height="28"
                                     Stroke="{DynamicResource CardBorderBrush}"
                                     StrokeThickness="3"/>
                            <Ellipse Width="28" Height="28"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="3"
                                     StrokeDashArray="2 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LoaderRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="WaitingHintText"
                                   Text="Waiting for punch..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RFID Card UID"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="CardUidTextBox"
                                     Height="40"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     IsUndoEnabled="False"
                                     Focusable="False"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     ToolTip="Card UID can only come from RFID punch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Border Height="40"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,0">
                                <TextBlock x:Name="ScanStatusText"
                                           Text="Select reader, then Wait for Punch."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, ElementName=ScanStatusText}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="AssignedCardBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource DangerBannerBgBrush}"
                            BorderBrush="{DynamicResource DangerBannerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Card already assigned — cannot register"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource DangerBannerFgBrush}"/>
                            <TextBlock x:Name="AssignedEmployeeText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 2: details locked until punch -->
            <StackPanel x:Name="EmployeeDetailsPanel" IsEnabled="False" Opacity="0.55">
                <TextBlock Text="Step 2: Employee details (unlocks after card punch)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Employee Code *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="CodeTextBox" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Employee Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="NameTextBox" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Department" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="DepartmentTextBox" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Designation" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="DesignationTextBox" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mobile" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="MobileTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

                <TextBlock Text="Chamber" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox x:Name="ChamberComboBox"
                          Height="40"
                          Margin="0,6,0,20"
                          Style="{StaticResource ThemedComboBoxStyle}"
                          IsEditable="False"
                          MaxDropDownHeight="220"
                          DisplayMemberPath="Label"
                          Cursor="Hand"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="110" Height="40"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        IsEnabled="False" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
