<Page x:Class="DashboardService.Views.SensorConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ConfigDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBgBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
        </Style>

        <Style x:Key="ConfigDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="ConfigDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ConfigDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConfigDataGridEditTextStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ModalCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel Margin="14,10,14,0">
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="Employees" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Background="{DynamicResource SidebarActiveBgBrush}"
                                Foreground="{DynamicResource SidebarTextActiveBrush}"
                                Click="ConfigurationToggle_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ConfigurationArrowText" Text="▲" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Visible">
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="SensorConfigurationMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sensor Configuration" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Edit COM port and gas threshold values from sensor_violations. All other fields are read only."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration"
                        Width="170"
                        Height="42"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="SaveConfiguration_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="COM Port Settings" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Only COM port can be edited." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="SensorsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}"
                                      MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberId}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="SENSOR TYPE" Binding="{Binding SensorType}" Width="1.2*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="MODEL" Binding="{Binding SensorModel}" Width="1*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="COM PORT" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="0.8*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"
                                                          EditingElementStyle="{StaticResource ConfigDataGridEditTextStyle}"/>
                                    <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="BAUD" Binding="{Binding BaudRate}" Width="0.6*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="ENABLED" Binding="{Binding Enabled}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Gas Threshold Values (sensor_violations)" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Edit threshold_value for active CO, CO2, and O2 violations." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="GasThresholdsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GAS" Binding="{Binding Parameter}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding ThresholdType}" Width="0.6*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="THRESHOLD VALUE" Binding="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}" Width="0.9*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"
                                                          EditingElementStyle="{StaticResource ConfigDataGridEditTextStyle}"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualValue}" Width="0.7*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="0.5*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Other Active Violations (Read Only)" Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid x:Name="OtherViolationsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}"
                                      IsReadOnly="True"
                                      MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PARAMETER" Binding="{Binding Parameter}" Width="0.9*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding ThresholdType}" Width="0.6*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="THRESHOLD VALUE" Binding="{Binding ThresholdValue}" Width="0.9*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="0.7*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualValue}" Width="0.7*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="0.5*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
