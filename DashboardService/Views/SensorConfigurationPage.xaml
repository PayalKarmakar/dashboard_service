<Page x:Class="DashboardService.Views.SensorConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      FontFamily="Bahnschrift, Segoe UI"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <!-- Soft row selection (avoid dark system highlight / sidebar blue) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF2FC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B2248"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF2FC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B2248"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.05" Color="#0A3776"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0B2248"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,3,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="RowHeight" Value="52"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="ConfigDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigHeaderRightStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ConfigDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ConfigDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0B2248"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FC"/>
                    <Setter Property="Foreground" Value="#0B2248"/>
                </Trigger>
            </Style.Triggers>
        </Style>

		<Style x:Key="ConfigDataGridTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#0B2248"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="8,0"/>
		</Style>

		<!-- Center aligned cell text -->
		<Style x:Key="ConfigDataGridTextCenterStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource ConfigDataGridTextStyle}">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>

		<!-- Center aligned column header -->
		<Style x:Key="ConfigHeaderCenterStyle"
       TargetType="DataGridColumnHeader"
       BasedOn="{StaticResource ConfigDataGridColumnHeaderStyle}">
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
		
		<Style x:Key="ConfigDataGridTextRightStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ConfigDataGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ConfigDataGridMutedStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ConfigDataGridTextStyle}">
            <Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="8,0"/>
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

        <Style x:Key="ConfigEditableFieldStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0A3776"/>
            <Setter Property="Background" Value="#EEF5FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0A3776"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="MaxWidth" Value="110"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="ConfigEditablePortStyle" TargetType="TextBox"
               BasedOn="{StaticResource ConfigEditableFieldStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="90"/>
        </Style>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="Badge"
                    CornerRadius="7"
                    Padding="9,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#FEF3C7">
                <TextBlock x:Name="BadgeText"
                           Text="{Binding Status}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#B45309"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="CRITICAL">
                    <Setter TargetName="Badge" Property="Background" Value="#FEE2E2"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WARNING">
                    <Setter TargetName="Badge" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                    <Setter TargetName="Badge" Property="Background" Value="#DCFCE7"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="14,10,14,0">
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="LiveCameraMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Camera" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ManualRfidMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇄" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Manual" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Height="40"
                                    Click="SensorReadingsReportMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensor Readings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="ConfigurationToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ConfigurationArrowText" Text="▲" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Visible">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40"
                                        Background="{DynamicResource SidebarActiveBgBrush}"
                                        Foreground="{DynamicResource SidebarTextActiveBrush}"
                                        Click="SensorConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                    <TextBlock Text="Sensor Configuration" FontSize="26" FontWeight="Bold" Foreground="#0B2248"/>
                    <TextBlock Text="Blue fields are editable. Click Save when done."
                               FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="SaveConfiguration_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- COM Port -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="3" Height="16" CornerRadius="2" Background="#0A3776" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sensor Configuration" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!--<TextBlock Text="Only the blue COM port field can be changed." Style="{StaticResource SectionHintStyle}"/>-->
							<DockPanel>
							<controls:PaginationBar x:Name="SensorsPagerBar" DockPanel.Dock="Bottom"/>
							<DataGrid x:Name="SensorsGrid"
                                  Style="{StaticResource ConfigDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                  RowStyle="{StaticResource ConfigDataGridRowStyle}"
                                  Margin="2,0,2,0"> 

								<DataGrid.Columns>

									<!-- CHAMBER -->
									<DataGridTextColumn Header="CHAMBER"
                                        Binding="{Binding ChamberId}"
                                        Width="0.8*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/>    

									<!-- SENSOR TYPE -->
									<DataGridTextColumn Header="SENSOR TYPE"
                                        Binding="{Binding SensorType}"
                                        Width="1.7*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>

									<!-- MODEL -->
									<DataGridTextColumn Header="MODEL"
                                        Binding="{Binding SensorModel}"
                                        Width="1.5*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/>


									<!--<DataGridTemplateColumn Header="COM PORT" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditablePortStyle}"
                                                         HorizontalAlignment="Left"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>-->

									<DataGridTextColumn Header="COM PORT"
                                        Binding="{Binding Port}"
                                        Width="1.2*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/>


									<!-- DEVICE ID -->
									<DataGridTextColumn Header="DEVICE ID"
                                        Binding="{Binding DeviceId}"
                                        Width="1.1*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/> 

									<!-- BAUD -->
									<DataGridTextColumn Header="BAUD RATE"
                                        Binding="{Binding BaudRate}"
                                        Width="1.1*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/>

									<!-- PARITY -->
									<DataGridTextColumn Header="PARITY"
                                        Binding="{Binding Parity}"
                                        Width="1.0*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource ConfigDataGridTextCenterStyle}"
                                        HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"/>


									<!-- ENABLED STATUS-->
									<DataGridTemplateColumn Header="STATUS"
                                            Width="1.2*"
                                            IsReadOnly="True"
                                            HeaderStyle="{StaticResource ConfigHeaderCenterStyle}"> 

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border Background="#DCFCE7"
                                                    BorderBrush="#BBF7D0"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"> 

													<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

														<Ellipse Width="7"
                                                             Height="7"
                                                             Fill="#16A34A"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>

														<TextBlock Text="ENABLED"
                                                               Foreground="#15803D"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>     

													</StackPanel>

												</Border>

											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>

								</DataGrid.Columns>

							</DataGrid>
							</DockPanel>
						</StackPanel>
                    </Border>

                    <!-- Master WARNING / CRITICAL limits -->
					<Border Style="{StaticResource SectionCardStyle}">
						<StackPanel>

							<!-- Section Header -->
							<StackPanel Orientation="Horizontal" Margin="0,0,0,2">
								<Border Width="3"
                    Height="16"
                    CornerRadius="2"
                    Background="#DC2626"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"/>

								<TextBlock Text="Warning / Critical Limits"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center"/>
							</StackPanel>

							<!-- Explanation -->
							<TextBlock Style="{StaticResource SectionHintStyle}"
                   Text="Configure the database warning and critical limits. The status ranges below show how sensor values will be interpreted."/>

							<DockPanel>
							<controls:PaginationBar x:Name="MasterThresholdsPagerBar" DockPanel.Dock="Bottom"/>
							<DataGrid x:Name="MasterThresholdsGrid"
          Style="{StaticResource ConfigDataGridStyle}"
          ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
          CellStyle="{StaticResource ConfigDataGridCellStyle}"
          RowStyle="{StaticResource ConfigDataGridRowStyle}"
          RowDetailsVisibilityMode="Collapsed"
          AutoGenerateColumns="False"
          Margin="10,0,10,0">

								<DataGrid.Columns>

									<!-- PARAMETER -->
									<DataGridTextColumn Header="PARAMETER"
                            Binding="{Binding Parameter}"
                            Width="1.2*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>

									<!-- TYPE -->
									<DataGridTextColumn Header="TYPE"
                            Binding="{Binding SensorType}"
                            Width="1*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>

									<!-- UNIT -->
									<DataGridTextColumn Header="UNIT"
                            Binding="{Binding Unit}"
                            Width="0.8*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>


									<!-- WARNING LOW -->
									<DataGridTemplateColumn Width="1.25*" HeaderStyle="{StaticResource ConfigHeaderCenterStyle}">

										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center">
													<TextBlock Text="WARNING LOW"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

													<TextBlock Text="Normal starts at"
                                   FontSize="10"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox Text="{Binding WarningLow,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ConfigEditableFieldStyle}"
                             HorizontalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>


									<!-- WARNING HIGH -->
									<DataGridTemplateColumn Width="1.25*" HeaderStyle="{StaticResource ConfigHeaderCenterStyle}">

										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center">
													<TextBlock Text="WARNING HIGH"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

													<TextBlock Text="Normal ends at"
                                   FontSize="10"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox Text="{Binding WarningHigh,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ConfigEditableFieldStyle}"
                             HorizontalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>


									<!-- CRITICAL LOW -->
									<DataGridTemplateColumn Width="1.25*" HeaderStyle="{StaticResource ConfigHeaderCenterStyle}">

										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center">
													<TextBlock Text="CRITICAL LOW"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

													<TextBlock Text="Critical below"
                                   FontSize="10"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox Text="{Binding CriticalLow,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ConfigEditableFieldStyle}"
                             HorizontalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>


									<!-- CRITICAL HIGH -->
									<DataGridTemplateColumn Width="1.25*" HeaderStyle="{StaticResource ConfigHeaderCenterStyle}">

										<DataGridTemplateColumn.HeaderTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center">
													<TextBlock Text="CRITICAL HIGH"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

													<TextBlock Text="Critical above"
                                   FontSize="10"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.HeaderTemplate>

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBox Text="{Binding CriticalHigh,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ConfigEditableFieldStyle}"
                             HorizontalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>


									<!-- STATUS RANGES -->
									<DataGridTemplateColumn Header="STATUS RANGES"
                                Width="1.25*">

										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>

												<Button Content="View ranges"
                            Tag="{Binding}"
                            Click="ViewThresholdRanges_Click"
                            Padding="12,5"
                            Margin="4,0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#2563EB"
                            FontSize="12"
                            FontWeight="SemiBold"/>

											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>

									</DataGridTemplateColumn>

								</DataGrid.Columns>


								<!-- Expanded interpretation -->
								<DataGrid.RowDetailsTemplate>
									<DataTemplate>

										<Border Margin="15,0,15,12"
                    Padding="16"
                    CornerRadius="8"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

											<StackPanel>

												<TextBlock Text="{Binding Parameter, StringFormat={}{0} — Resulting Status Ranges}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

												<ItemsControl ItemsSource="{Binding StatusRanges}">

													<ItemsControl.ItemTemplate>
														<DataTemplate>

															<Grid Margin="0,3">

																<Grid.ColumnDefinitions>
																	<ColumnDefinition Width="110"/>
																	<ColumnDefinition Width="*"/>
																</Grid.ColumnDefinitions>

																<TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"/>

																<TextBlock Grid.Column="1"
                                               Text="{Binding Range}"
                                               Foreground="#475569"/>

															</Grid>

														</DataTemplate>
													</ItemsControl.ItemTemplate>

												</ItemsControl>

											</StackPanel>

										</Border>

									</DataTemplate>
								</DataGrid.RowDetailsTemplate>

							</DataGrid>
							</DockPanel>

						</StackPanel>
					</Border>

					
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
