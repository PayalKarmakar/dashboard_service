<Page x:Class="DashboardService.Views.SensorConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FontFamily="Bahnschrift, Segoe UI"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <!-- Soft row selection (avoid dark system highlight / sidebar blue) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF2FC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B2248"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF2FC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0B2248"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.05" Color="#0A3776"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0B2248"/>
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,3,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="ConfigDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigHeaderRightStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ConfigDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ConfigDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0B2248"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FC"/>
                    <Setter Property="Foreground" Value="#0B2248"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigDataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0B2248"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ConfigDataGridTextRightStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ConfigDataGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ConfigDataGridMutedStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ConfigDataGridTextStyle}">
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="ConfigEditableFieldStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0A3776"/>
            <Setter Property="Background" Value="#EEF5FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0A3776"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="MaxWidth" Value="110"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="ConfigEditablePortStyle" TargetType="TextBox"
               BasedOn="{StaticResource ConfigEditableFieldStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="90"/>
        </Style>

        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="Badge"
                    CornerRadius="7"
                    Padding="9,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#FEF3C7">
                <TextBlock x:Name="BadgeText"
                           Text="{Binding Status}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#B45309"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="CRITICAL">
                    <Setter TargetName="Badge" Property="Background" Value="#FEE2E2"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WARNING">
                    <Setter TargetName="Badge" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                    <Setter TargetName="Badge" Property="Background" Value="#DCFCE7"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="14,10,14,0">
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="ConfigurationToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ConfigurationArrowText" Text="▲" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Visible">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40"
                                        Background="{DynamicResource SidebarActiveBgBrush}"
                                        Foreground="{DynamicResource SidebarTextActiveBrush}"
                                        Click="SensorConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                    <TextBlock Text="Sensor Configuration" FontSize="26" FontWeight="Bold" Foreground="#0B2248"/>
                    <TextBlock Text="Blue fields are editable. Click Save when done."
                               FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="SaveConfiguration_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- COM Port -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="3" Height="16" CornerRadius="2" Background="#0A3776" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="COM Port Settings" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Only the blue COM port field can be changed." Style="{StaticResource SectionHintStyle}"/>
                            <DataGrid x:Name="SensorsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberId}" Width="90" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="SENSOR TYPE" Binding="{Binding SensorType}" Width="*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="MODEL" Binding="{Binding SensorModel}" Width="140" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                    <DataGridTemplateColumn Header="COM PORT" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditablePortStyle}"
                                                         HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="90" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextRightStyle}"
                                                          HeaderStyle="{StaticResource ConfigHeaderRightStyle}"/>
                                    <DataGridTextColumn Header="BAUD" Binding="{Binding BaudRate}" Width="80" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextRightStyle}"
                                                          HeaderStyle="{StaticResource ConfigHeaderRightStyle}"/>
                                    <DataGridTextColumn Header="ENABLED" Binding="{Binding Enabled}" Width="90" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Master WARNING / CRITICAL limits -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="3" Height="16" CornerRadius="2" Background="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Warning / Critical Limits" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Blue number fields set WARNING / CRITICAL limits. Leave blank if unused."
                                       Style="{StaticResource SectionHintStyle}"/>
                            <DataGrid x:Name="MasterThresholdsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PARAMETER" Binding="{Binding Parameter}" Width="120" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding SensorType}" Width="90" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                    <DataGridTemplateColumn Header="WARN LOW" Width="*" HeaderStyle="{StaticResource ConfigHeaderRightStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding WarningLow, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditableFieldStyle}"
                                                         HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="WARN HIGH" Width="*" HeaderStyle="{StaticResource ConfigHeaderRightStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding WarningHigh, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditableFieldStyle}"
                                                         HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CRIT LOW" Width="*" HeaderStyle="{StaticResource ConfigHeaderRightStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CriticalLow, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditableFieldStyle}"
                                                         HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CRIT HIGH" Width="*" HeaderStyle="{StaticResource ConfigHeaderRightStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CriticalHigh, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditableFieldStyle}"
                                                         HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Gas + Other side by side on wide screens via two stacked compact cards -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="3" Height="16" CornerRadius="2" Background="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Active Gas Violations" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Open CO / CO2 / O2 events. Threshold value is editable."
                                       Style="{StaticResource SectionHintStyle}"/>
                            <DataGrid x:Name="GasThresholdsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GAS" Binding="{Binding Parameter}" Width="80" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding ThresholdType}" Width="70" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                    <DataGridTemplateColumn Header="THRESHOLD" Width="120" HeaderStyle="{StaticResource ConfigHeaderRightStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ConfigEditableFieldStyle}"
                                                         HorizontalAlignment="Right"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="110" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <StaticResource ResourceKey="StatusBadgeTemplate"/>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualValue}" Width="*" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridTextRightStyle}"
                                                          HeaderStyle="{StaticResource ConfigHeaderRightStyle}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70" IsReadOnly="True"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="3" Height="16" CornerRadius="2" Background="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Other Active Violations" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                <Border Background="#F1F5F9" CornerRadius="7" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Read only" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Temperature and humidity open violations." Style="{StaticResource SectionHintStyle}"/>
                            <DataGrid x:Name="OtherViolationsGrid"
                                      Style="{StaticResource ConfigDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ConfigDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource ConfigDataGridCellStyle}"
                                      RowStyle="{StaticResource ConfigDataGridRowStyle}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PARAMETER" Binding="{Binding Parameter}" Width="120"
                                                          ElementStyle="{StaticResource ConfigDataGridTextStyle}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding ThresholdType}" Width="70"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                    <DataGridTextColumn Header="THRESHOLD" Binding="{Binding ThresholdValue}" Width="110"
                                                          ElementStyle="{StaticResource ConfigDataGridTextRightStyle}"
                                                          HeaderStyle="{StaticResource ConfigHeaderRightStyle}"/>
                                    <DataGridTemplateColumn Header="STATUS" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <StaticResource ResourceKey="StatusBadgeTemplate"/>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualValue}" Width="*"
                                                          ElementStyle="{StaticResource ConfigDataGridTextRightStyle}"
                                                          HeaderStyle="{StaticResource ConfigHeaderRightStyle}"/>
                                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="70"
                                                          ElementStyle="{StaticResource ConfigDataGridMutedStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
