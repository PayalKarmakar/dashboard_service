<Window x:Class="DashboardService.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModalBgBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <Border Margin="24" Background="{DynamicResource ModalCardBrush}" CornerRadius="16" Padding="28,24"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Add User" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Create a login account for the dashboard" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,18"/>

            <TextBlock Text="Username *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="UserNameTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="FullNameTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBox x:Name="EmailTextBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Role *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <ComboBox x:Name="RoleComboBox"
                      Height="40"
                      Margin="0,6,0,14"
                      Padding="8,0"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="RoleName"
                      Background="{DynamicResource InputBgBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Password *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Text="Confirm Password *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Margin="0,6,0,14" Padding="10,0" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

            <CheckBox x:Name="ActiveCheckBox"
                      Content="Active"
                      IsChecked="True"
                      Margin="0,0,0,20"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                        Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" Click="Cancel_Click"/>
                <Button Content="Save" Width="110" Height="40" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
