<Page x:Class="DashboardService.Views.ManualRfidTransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Border x:Name="SidebarSciFiOverlay" Opacity="0" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="95"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,20,0">
                        <TextBlock Text="SRP INNOVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarBrandBrush}"/>
                        <TextBlock Text="Smart Chamber" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextActiveBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="14,10,14,0">
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="19" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ChambersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chambers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="EmployeesMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Employees" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReadersMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊛" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Readers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="LiveCameraMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◎" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Camera" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Background="{DynamicResource SidebarActiveBgBrush}"
                                    Foreground="{DynamicResource SidebarTextActiveBrush}"
                                    Click="ManualRfidMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇄" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                    <TextBlock Text="RFID Manual" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ReportsToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▤" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ReportsArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ReportsSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="EntryExitReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entry / Exit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraAccessReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera Access" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberEmployeesReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Employees" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ChamberCriticalReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chamber Critical" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="ProductionLossReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Production Loss" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorReadingsReportMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor Readings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="ConfigurationToggle_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="18" Width="30" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ConfigurationArrowText" Text="▼" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="ConfigurationSubMenuPanel" Margin="18,0,0,4" Visibility="Collapsed">
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="SensorConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sensor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SidebarButtonStyle}" Height="40" Click="CameraConfigurationMenu_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▸" FontSize="14" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,12,10">
                        <TextBlock Text="© 2026 SRP Innovations" Foreground="{DynamicResource SidebarBrandBrush}" FontSize="10" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RFID Manual Open / Close" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manually open (entry) or close (exit) RFID transactions"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Width="100"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="{DynamicResource ButtonSecondaryBgBrush}"
                            Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Click="Refresh_Click"/>
                    <Button x:Name="OpenEntryButton"
                            Content="Open Entry"
                            Width="130"
                            Height="40"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="OpenEntry_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="OPEN (INSIDE)"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="8,8,8,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:PaginationBar x:Name="OpenPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="OpenGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="1.1*"/>
                            <DataGridTextColumn Header="CODE" Binding="{Binding EmployeeCode}" Width="0.7*"/>
                            <DataGridTextColumn Header="CARD" Binding="{Binding CardUid}" Width="0.8*"/>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="0.9*"/>
                            <DataGridTextColumn Header="ENTRY TIME" Binding="{Binding EntryDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="1.1*"/>
                            <DataGridTextColumn Header="MANUAL" Binding="{Binding ManualDisplay}" Width="0.55*"/>
                            <DataGridTemplateColumn Header="ACTION" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Close"
                                                Height="28"
                                                Padding="10,0"
                                                Margin="4,2"
                                                Cursor="Hand"
                                                Background="#FF3B30"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="Close_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="RECENT TRANSACTIONS"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="8,8,8,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:PaginationBar x:Name="RecentPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="RecentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="1.1*"/>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="0.9*"/>
                            <DataGridTextColumn Header="ENTRY" Binding="{Binding EntryDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="EXIT" Binding="{Binding ExitDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay}" Width="0.85*"/>
                            <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="1*"/>
                            <DataGridTextColumn Header="MANUAL" Binding="{Binding ManualDisplay}" Width="0.5*"/>
                            <DataGridTextColumn Header="CORRECTED AT" Binding="{Binding CorrectedAtDisplay}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
