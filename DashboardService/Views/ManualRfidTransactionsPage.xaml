<Page x:Class="DashboardService.Views.ManualRfidTransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DashboardService.Controls"
      Background="{DynamicResource AppBgBrush}">


        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RFID Manual Open / Close" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manually open (entry) or close (exit) RFID transactions"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Width="100"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="{DynamicResource ButtonSecondaryBgBrush}"
                            Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            Click="Refresh_Click"/>
                    <Button x:Name="OpenEntryButton"
                            Content="Open Entry"
                            Width="130"
                            Height="40"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="OpenEntry_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="OPEN (INSIDE)"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="8,8,8,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:PaginationBar x:Name="OpenPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="OpenGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="1.1*"/>
                            <DataGridTextColumn Header="CODE" Binding="{Binding EmployeeCode}" Width="0.7*"/>
                            <DataGridTextColumn Header="CARD" Binding="{Binding CardUid}" Width="0.8*"/>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="0.9*"/>
                            <DataGridTextColumn Header="ENTRY TIME" Binding="{Binding EntryDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="1.1*"/>
                            <DataGridTextColumn Header="MANUAL" Binding="{Binding ManualDisplay}" Width="0.55*"/>
                            <DataGridTemplateColumn Header="ACTION" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Close"
                                                Height="28"
                                                Padding="10,0"
                                                Margin="4,2"
                                                Cursor="Hand"
                                                Background="#FF3B30"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="Close_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="RECENT TRANSACTIONS"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="8,8,8,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:PaginationBar x:Name="RecentPagerBar" DockPanel.Dock="Bottom"/>
                    <DataGrid x:Name="RecentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="1.1*"/>
                            <DataGridTextColumn Header="CHAMBER" Binding="{Binding ChamberName}" Width="0.9*"/>
                            <DataGridTextColumn Header="ENTRY" Binding="{Binding EntryDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="EXIT" Binding="{Binding ExitDisplay}" Width="1.1*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay}" Width="0.85*"/>
                            <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="1*"/>
                            <DataGridTextColumn Header="MANUAL" Binding="{Binding ManualDisplay}" Width="0.5*"/>
                            <DataGridTextColumn Header="CORRECTED AT" Binding="{Binding CorrectedAtDisplay}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
</Page>
