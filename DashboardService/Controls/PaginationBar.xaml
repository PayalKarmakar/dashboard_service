<UserControl x:Class="DashboardService.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            Padding="0,2,0,0"
            Background="Transparent">
        <DockPanel LastChildFill="False">
            <TextBlock x:Name="SummaryText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="4,0,12,0"/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PrevButton"
                        Content="‹ Prev"
                        Width="68"
                        Height="28"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        FontSize="11"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Prev_Click"/>
                <TextBlock x:Name="PageText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,6,0"
                           MinWidth="78"
                           TextAlignment="Center"/>
                <Button x:Name="NextButton"
                        Content="Next ›"
                        Width="68"
                        Height="28"
                        Cursor="Hand"
                        FontSize="11"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Next_Click"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
