<UserControl x:Class="DashboardService.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="4,8,4,4"
            Background="Transparent">
        <DockPanel LastChildFill="False">
            <TextBlock x:Name="SummaryText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="4,0,12,0"/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PrevButton"
                        Content="‹ Prev"
                        Width="72"
                        Height="30"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Prev_Click"/>
                <TextBlock x:Name="PageText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,8,0"
                           MinWidth="90"
                           TextAlignment="Center"/>
                <Button x:Name="NextButton"
                        Content="Next ›"
                        Width="72"
                        Height="30"
                        Cursor="Hand"
                        Background="{DynamicResource ButtonSecondaryBgBrush}"
                        Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Click="Next_Click"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
